---
import Icon from '../ui/Icon.astro';

/**
 * Back and next.
 *
 * The whole journal fits on one page, so both controls are disabled rather than
 * linking nowhere. Pass `back` and `next` once there is more than one page of
 * posts and they become links.
 */
interface Props {
  back?: string;
  next?: string;
  /** Words and landmark label, in the page's language. */
  labels?: { back: string; next: string; nav: string };
}

const { back, next, labels = { back: 'Back', next: 'Next', nav: 'Pagination' } } = Astro.props;
---

<nav class="pagination" aria-label={labels.nav}>
  {
    back ? (
      <a class="pagin" href={back} rel="prev">
        <Icon name="pagin-prev" class="pagin-icon" />
        <span class="pagin-text w-inline-block">{labels.back}</span>
      </a>
    ) : (
      <span class="pagin" aria-disabled="true">
        <Icon name="pagin-prev" class="pagin-icon" />
        <span class="pagin-text w-inline-block">{labels.back}</span>
      </span>
    )
  }
  {
    next ? (
      <a class="pagin" href={next} rel="next">
        <span class="pagin-text w-inline-block">{labels.next}</span>
        <Icon name="pagin-next" class="pagin-icon" />
      </a>
    ) : (
      <span class="pagin" aria-disabled="true">
        <span class="pagin-text w-inline-block">{labels.next}</span>
        <Icon name="pagin-next" class="pagin-icon" />
      </span>
    )
  }
</nav>
