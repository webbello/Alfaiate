---
import Icon from '../ui/Icon.astro';

/**
 * The request list button and the panel behind it (the theme's cart, used without prices or payment).
 * Labels come from our dictionary in the page's language; `scripts/cart.ts` fills the list and the link to the request form.
 * The design places this twice: in the desktop menu row, and again in the mobile bar beside the menu toggle. `id` keeps the two apart.
 */
interface Props {
  id: string;
  list: {
    toggle: string;
    title: string;
    close: string;
    empty: string;
    remove: string;
    removeNamed: string;
    send: string;
    full: string;
    note: string;
    subtotal: string;
    itemsHeading: string;
    tailorsHeading: string;
    quantityNamed: string;
    fullItems: string;
  };
  requestHref: string;
}

const { id, list, requestHref } = Astro.props;
---

<div class="header-cart-block">
  <div
    class="header-cart"
    data-cart
    data-max="3"
    data-request-href={requestHref}
    data-label-remove={list.remove}
    data-label-remove-named={list.removeNamed}
    data-label-full={list.full}
    data-label-full-items={list.fullItems}
    data-label-items={list.itemsHeading}
    data-label-tailors={list.tailorsHeading}
    data-label-qty={list.quantityNamed}
  >
    <button type="button" class="header-cart-button w-inline-block" aria-expanded="false" aria-controls={`${id}-panel`} data-cart-toggle>
      <span class="header-cart-text w-inline-block">{list.toggle}</span>
      <Icon name="cart" class="header-cart-icon" />
      <span class="header-cart-num" data-cart-count>0</span>
    </button>

    <div class="header-cart-wrapp" id={`${id}-panel`} data-cart-panel>
      <div class="header-cart-wrap">
        <div class="header-cart-header">
          <h4 class="header-cart-title">{list.title}</h4>
          <button type="button" class="header-cart-close w-inline-block" aria-label={list.close} data-cart-close>
            <Icon name="close" />
          </button>
        </div>

        <div class="header-cart-footer">
          <div class="header-cart-default" data-cart-lines hidden>
            <div class="header-cart-list" data-cart-items></div>
            <div class="header-cart-link" data-cart-subtotal hidden>
              <div class="header-cart-prices">
                <div>{list.subtotal}</div>
                <div data-cart-total>&mdash;</div>
              </div>
            </div>
            <p class="header-cart-note">{list.note}</p>
            <p class="header-cart-status" role="status" data-cart-status></p>
            <a class="button w-inline-block header-cart-send" href={requestHref} data-cart-send>
              <div class="button-bg"></div>
              <div class="button-text">{list.send}</div>
              <div class="button-wrap">
                <Icon name="arrow-up-right" class="button-icon" />
                <Icon name="arrow-up-right" class="button-icon" />
              </div>
            </a>
          </div>

          <div class="header-cart-empty" data-cart-empty>
            <div>{list.empty}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
