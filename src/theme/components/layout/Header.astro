---
import CartDrawer from './CartDrawer.astro';
import LangSwitch from './LangSwitch.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import type { Link } from '../../config/nav';

/**
 * The bar across the top of every page.
 *
 * The design carries the navigation twice: once for the overlay the menu button
 * opens, and once for the row that runs along the top from 992px up. They are
 * separate blocks rather than one that reflows, so both are rendered and the
 * stylesheet decides which is shown — the same arrangement the export uses.
 */
interface Props {
  /** Set on pages whose hero sits behind the bar. */
  overlay?: boolean;
  /** The same page in the other language (Alfaiate TL addition): a small EN | TET switch in the menu. */
  twin?: { path: string; lang: 'en' | 'tet' } | null;
  /** Menus in the page's language (src/theme/config/nav.ts). */
  nav: Link[];
  mega: Link[];
  homeHref: string;
  labels: { main: string; pages: string; menu: string };
  list: {
    toggle: string;
    title: string;
    close: string;
    empty: string;
    remove: string;
    removeNamed: string;
    send: string;
    full: string;
    note: string;
    subtotal: string;
    itemsHeading: string;
    tailorsHeading: string;
    quantityNamed: string;
    fullItems: string;
    orderButton: string;
    requestTailors: string;
  };
  requestHref: string;
  orderHref: string;
}

const { overlay = false, twin = null, nav, mega, homeHref, labels, list, requestHref, orderHref } = Astro.props;

const path = Astro.url.pathname;
/** The overlay menu spells two links out in full; the top row keeps them short. */
const MOBILE_LABEL: Record<string, string> = {};
const isCurrent = (href: string) => path === href;
---

<header
  class:list={['header-section', overlay && 'is-overlay']}
  data-header
>
  <div class="header-block main-container">
    <div class="header-brand-block">
      <a aria-label={SITE.name} href={homeHref} class="header-brand w-inline-block">
        <span class="brand-mark"><span class="brand-name">Alfaiate</span> <span class="brand-tl">TL</span></span>
      </a>
    </div>

    {/* The overlay menu, shown below 992px. */}
    <nav class="header-menu-block is-display-show-for-mobile w-nav-menu" data-nav-menu aria-label={labels.main}>
      <div class="header-menu">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={['header-menu-link', 'w-nav-link', isCurrent(item.href) && 'is-current']}
            >
              {MOBILE_LABEL[item.label] ?? item.label}
            </a>
          ))
        }

        <div class="header-dropdown w-dropdown" data-dropdown>
          <button
            type="button"
            class="header-toggle w-dropdown-toggle"
            aria-expanded="false"
            aria-controls="mega-menu-mobile"
            data-dropdown-toggle
          >
            <span class="header-dropdown-text">{labels.pages}</span>
            <Icon name="chevron-down" class="header-dropdown-icon" />
          </button>

          <div class="header-wrapp w-dropdown-list" id="mega-menu-mobile" data-dropdown-list>
            <div class="w-layout-grid header-megamenu">
              {
                mega.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={['header-menu-link', isCurrent(item.href) && 'is-current']}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

      </div>
    </nav>

    {/* The row, shown from 992px up. */}
    <div class="header-menu-block is-display-show-for-desktop">
      <div class="header-menu header-menu-wrap">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={['header-menu-link', 'w-nav-link', isCurrent(item.href) && 'is-current']}
            >
              {item.label}
            </a>
          ))
        }

        <div class="header-dropdown w-dropdown" data-dropdown>
          <button
            type="button"
            class="header-toggle w-dropdown-toggle"
            aria-expanded="false"
            aria-controls="mega-menu-desktop"
            data-dropdown-toggle
          >
            <span class="header-dropdown-text">{labels.pages}</span>
            <Icon name="chevron-down" class="header-dropdown-icon" />
          </button>

          <div class="header-wrapp w-dropdown-list" id="mega-menu-desktop" data-dropdown-list>
            <div class="w-layout-grid header-megamenu">
              {
                mega.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class:list={['header-menu-link', isCurrent(item.href) && 'is-current']}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        {twin && <LangSwitch {twin} />}

        <CartDrawer id="cart-desktop" {list} {requestHref} {orderHref} />
      </div>
    </div>

    <div class="header-wrap-block">
      {twin && <LangSwitch {twin} class="is-compact" />}
      <CartDrawer id="cart-mobile" {list} {requestHref} {orderHref} />

      <button
        type="button"
        class="header-line-block w-nav-button"
        aria-expanded="false"
        aria-label={labels.menu}
        data-nav-toggle
      >
        <span class="header-menu-line">
          <span class="top"></span>
          <span class="middle"></span>
          <span class="bottom"></span>
        </span>
      </button>
    </div>
  </div>
</header>
