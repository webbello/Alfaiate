---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../config/site';
import type { FooterGroup } from '../../config/nav';

/**
 * The footer, on every page.
 *
 * Three link columns and a newsletter sign-up sit in one three-column grid —
 * the call to action spans all three and the middle and right columns are
 * placed by `additions.css`, because the export attached that placement to
 * generated element ids rather than to a class. The bottom row is a second
 * grid reading left, center, right.
 */
interface Props {
  groups: FooterGroup[];
  homeHref: string;
  tagline: string;
  closing: string;
  rights: string;
  /** The disclaimer every page carries (FR-PUB-02): we introduce tailors, they agree price and dates. */
  note?: string;
  siteName: string;
  /** Our own social links (set in the environment, platform hosts only), not the theme's demo profiles. */
  social: { label: string; href: string; icon: string }[];
}
const { groups, homeHref, tagline, closing, rights, siteName, social, note } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
const year = new Date().getFullYear();
---

<footer class="footer-section">
  <div class="w-layout-blockcontainer main-container w-container">
    <div class="footer-block">
      <div class="footer-menu-block">
        <div class="footer-text-block">
          <a aria-label={SITE.name} href={homeHref} class="footer-brand w-inline-block">
            <span class="brand-mark brand-mark--footer"><span class="brand-name">Alfaiate</span> <span class="brand-tl">TL</span></span>
          </a>

          <div class="footer-except">
            <div class="footer-except-text">{tagline}</div>
          </div>

          <div class="footer-social">
            {
              social.map((profile) => (
                <a
                  aria-label={profile.label}
                  href={profile.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-social-link w-inline-block"
                >
                  <Icon name={profile.icon} class="footer-social-icon" />
                </a>
              ))
            }
          </div>
        </div>

        <div class="footer-line-block">
          <div class="footer-line"></div>
        </div>

        <div class="footer-nav-block">
          {
            groups.map((group) => (
              <div class="footer-nav">
                <div class="footer-nav-title">{group.title}</div>
                <div class="footer-nav-wrap">
                  {group.links.map((link) => (
                    <a
                      href={link.href}
                      aria-current={current(link.href)}
                      class:list={['footer-nav-link', path === link.href && 'is-current']}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }

          <slot name="newsletter" />
        </div>
      </div>

      <div class="footer-divider-block">
        <div class="footer-divider"></div>
      </div>

      <div class="footer-copy-block">
        <ul class="footer-copy-text" role="list">
          <li>&copy; {year} {siteName}. {rights}</li>
        </ul>
        <ul class="footer-copy-text" role="list">
          <li>{closing}</li>
          {note && <li>{note}</li>}
        </ul>
      </div>
    </div>
  </div>
</footer>
