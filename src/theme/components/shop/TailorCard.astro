---
// A listed tailor in the theme's product-card style (classes shop-card, shop-thumb, shop-name). Used by the home page slider now and by the directory in step 4.
import { photoUrl, photoSrcset } from '../../../modules/media/urls';
import Icon from '../ui/Icon.astro';
import { fill } from '../../../i18n/public';
import { initials } from '../../../components/story/variant';
import { pathFor, type Lang } from '../../../i18n/lang';
import { priceText } from '../../../modules/directory/format';
import { whatsappLink, whatsappMessage } from '../../../modules/contact-links/whatsapp';
import type { Dictionary } from '../../../i18n/public/en';
import type { CardView } from '../../../modules/directory/view';

interface Props {
  lang: Lang;
  t: Dictionary;
  tailor: CardView;
  sizes?: string;
}
const { lang, t, tailor, sizes = '(max-width: 767px) 88vw, 30vw' } = Astro.props;
const href = pathFor(lang, `/tailors/${tailor.slug}`);
const price = priceText(t, tailor.priceHint?.from ?? null, tailor.priceHint?.to ?? null);
// What a card says under the name: the shop's place first, then the one priced work type (never a mixed range).
const place = tailor.areas[0] ?? null;
// A stored number that is not valid must never take the page down: the button is then simply left out.
const whatsapp = (() => {
  try {
    return tailor.whatsapp ? whatsappLink(tailor.whatsapp, whatsappMessage(t, tailor.name)) : null;
  } catch {
    return null;
  }
})();
const priceLine =
  price && tailor.priceCategory
    ? fill(t.price.cardLine, { category: tailor.priceCategory, price })
    : null;
---

<div class="shop-card">
  <div class="shop-thumb-card">
    {
      tailor.photo ? (
        <img
          class="shop-thumb"
          src={photoUrl(tailor.photo.base, 'medium')}
          srcset={photoSrcset(tailor.photo.base, [['thumb', 320], ['medium', 800]])}
          sizes={sizes}
          alt={tailor.photo.alt}
          loading="lazy"
        />
      ) : (
        <div class="shop-thumb shop-thumb--initials" data-initials={initials(tailor.name)} aria-hidden="true" />
      )
    }
    <div class="shop-details">
      <a class="button is-shop w-inline-block" {href} aria-label={`${t.home.featured.view}: ${tailor.name}`}>
        <div class="button-bg"></div>
        <div class="button-text">{t.home.featured.view}</div>
      </a>
    </div>
  </div>
  <div class="shop-details-card">
    <div class="shop-info-card">
      <a class="shop-name" {href}>{tailor.name}</a>
      {place && <div class="shop-price">{place}</div>}
      {priceLine && <div class="shop-price shop-price--small">{priceLine}</div>}
      {tailor.homeVisits === 'yes' && <div class="shop-price shop-price--small">{t.directory.homeVisits}</div>}
    </div>
    <form
      class="shop-bag-card"
      method="get"
      action={pathFor(lang, '/request')}
      data-add-to-cart
      data-name={tailor.name}
      data-url={href}
      data-image={tailor.photo ? photoUrl(tailor.photo.base, 'thumb') : ''}
    >
      <input type="hidden" name="tailor" value={tailor.slug} />
      <button type="submit" aria-label={fill(t.requestList.add, { name: tailor.name })} title={t.requestList.addLabel}>
        <Icon name="shop-bag" class="shop-bag" />
      </button>
    </form>
    {
      whatsapp && (
        <a class="shop-whatsapp" href={whatsapp} data-contact-channel="whatsapp" data-tailor={tailor.slug} aria-label={fill(t.home.featured.whatsapp, { name: tailor.name })}>
          <Icon name="whatsapp" />
        </a>
      )
    }
  </div>
</div>
