---
// The journal list, or one category of it (docs/SPEC-handspark-theme.md, step 6). Owner-written articles only; samples show in development and are labelled.
import { env } from 'cloudflare:workers';
import ThemeLayout from '../../layouts/ThemeLayout.astro';
import Hero from '../components/sections/Hero.astro';
import { dictionary } from '../../i18n/public';
import { pathFor, type Lang } from '../../i18n/lang';
import { testimonialPlaceholders } from '../../modules/config';
import { CATEGORIES, categoryOf, visiblePosts } from '../../modules/journal/posts';
import { initials } from '../../components/story/variant';
import { isIndexable } from '../../modules/seo/pages';

interface Props {
  lang: Lang;
  category?: string;
}
const { lang, category } = Astro.props;
const t = dictionary(lang);
const j = t.journal;
const showSamples = testimonialPlaceholders(env as { SHOW_TESTIMONIAL_PLACEHOLDERS?: string });
const all = visiblePosts(showSamples);
const posts = category ? all.filter((p) => p.category === category) : all;
const current = category ? categoryOf(category) : undefined;
const title = current ? current.name[lang] : j.heading;
const date = (iso: string) => new Intl.DateTimeFormat(lang === 'tet' ? 'pt-PT' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(iso));
import MotionScript from '../components/layout/MotionScript.astro';
---

<ThemeLayout
  {lang}
  title={`${title} · ${t.siteName}`}
  description={j.intro}
  rest={current ? `/journal/category/${category}` : '/journal'}
  noindex={!isIndexable('journal') || posts.length === 0 || posts.some((p) => p.sample)}
>
  <Hero parent={{ label: j.heading, href: pathFor(lang, '/journal') }} variant="cms" tag={j.heading} title={title} />
  <section class="global-section">
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="blog-block">
        <nav class="dir-browse" aria-label={j.categories}>
          <ul>
            <li><a href={pathFor(lang, '/journal')} aria-current={category ? undefined : 'page'}>{j.all}</a></li>
            {CATEGORIES.map((c) => <li><a href={pathFor(lang, `/journal/category/${c.slug}`)} aria-current={c.slug === category ? 'page' : undefined}>{c.name[lang]}</a></li>)}
          </ul>
        </nav>
        {posts.length === 0 && <p class="dir-intro">{j.empty}</p>}
        <div class="blog-list">
          {
            posts.map((post) => (
              <div class="blog-item" data-anim="fade">
                <a class="blog-card w-inline-block" href={pathFor(lang, `/journal/${post.slug}`)}>
                  <div class="blog-thumb-card">
                    <div class="blog-thumb shop-thumb--initials" data-initials={initials(categoryOf(post.category)?.name[lang] ?? post.title[lang])} aria-hidden="true"></div>
                  </div>
                  <div class="blog-details-card is-main-blog">
                    <div class="blog-date"><time datetime={post.date}>{date(post.date)}</time></div>
                    <div class="blog-name">{post.title[lang]}</div>
                    {post.sample && <div class="blog-date">{j.sample}</div>}
                  </div>
                </a>
              </div>
            ))
          }
        </div>
        <p class="meta"><a href="/rss.xml">{j.rss}</a></p>
      </div>
    </div>
  </section>
</ThemeLayout>

<MotionScript />
