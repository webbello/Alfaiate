---
import '../styles/admin.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { en } from '../i18n/en';
import { currentKey, navLinks } from '../modules/admin-ui/nav';

interface Props {
  title: string;
  description?: string;
  /** The signed-in user. Left out for the sign-in page, which gets a small centred card and no header bar. */
  auth?: { email: string; role: string; csrfToken: string };
}
const { title, description = title, auth } = Astro.props;
const current = currentKey(Astro.url.pathname);
const links = auth ? navLinks(auth.role) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {en.adminTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    {auth ? (
      <>
        <a class="skip-link" href="#main">
          Skip to main content
        </a>
        <header class="admin-header">
          <div class="admin-header__inner">
            <a class="admin-brand" href="/admin">
              <span class="admin-brand__mark"><AdminIcon name="logo" /></span>
              Alfaiate TL admin
            </a>
            <input
              class="admin-menu-toggle"
              type="checkbox"
              id="admin-menu"
              aria-label="Menu"
            />
            <label
              class="admin-menu-button"
              for="admin-menu"
              aria-hidden="true"
            >
              Menu
            </label>
            <div class="admin-panel">
              <nav class="admin-nav" aria-label="Admin">
                {links.map((link, i) => (
                  <>
                    {(i === 0 || link.group !== links[i - 1].group) && (
                      <p class="admin-nav__group">{link.group}</p>
                    )}
                    <a
                      href={link.href}
                      aria-current={link.key === current ? 'page' : undefined}
                    >
                      <AdminIcon name={link.key} />
                      {link.label}
                    </a>
                  </>
                ))}
              </nav>
              <div class="admin-user">
                <span>
                  {auth.email} ({auth.role})
                </span>
                <form method="post" action="/admin/logout">
                  <input type="hidden" name="csrf" value={auth.csrfToken} />
                  <button type="submit">{en.adminSignOut}</button>
                </form>
              </div>
            </div>
          </div>
        </header>
        <main id="main" class="admin-main">
          <slot />
        </main>
      </>
    ) : (
      <main class="admin-card-page">
        <slot />
      </main>
    )}
  </body>
</html>
