---
import '../styles/admin.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { en } from '../i18n/en';

interface Props {
  title: string;
  description?: string;
  /** The signed-in tailor. Left out for the sign-in and accept pages, which get a small centred card. */
  auth?: { email: string; csrfToken: string };
}
const { title, description = title, auth } = Astro.props;
const p = en.portal;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/portal';
const links = [
  { href: '/portal', label: p.overview },
  { href: '/portal/profile', label: p.profileNav },
  { href: '/portal/work', label: p.workNav },
  { href: '/portal/photos', label: p.photosNav },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {p.brand}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
  </head>
  <body>
    {auth ? (
      <>
        <a class="skip-link" href="#main">
          Skip to main content
        </a>
        <header class="portal-header">
          <div class="portal-header__inner">
            <a class="admin-brand" href="/portal">
              <span class="admin-brand__mark">
                <AdminIcon name="logo" />
              </span>
              {p.brand}
            </a>
            <nav class="portal-steps" aria-label="Your page">
              {links.map((l) => (
                <a
                  href={l.href}
                  aria-current={l.href === path ? 'page' : undefined}
                >
                  {l.label}
                </a>
              ))}
            </nav>
            <form class="portal-user" method="post" action="/portal/logout">
              <input type="hidden" name="csrf" value={auth.csrfToken} />
              <span>{auth.email}</span>
              <button type="submit" class="secondary">
                {p.signOut}
              </button>
            </form>
          </div>
        </header>
        <main id="main" class="portal-main">
          <slot />
        </main>
      </>
    ) : (
      <main class="admin-card-page">
        <slot />
      </main>
    )}
  </body>
</html>
