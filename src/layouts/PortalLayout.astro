---
// The signed-in tailor portal in the site's own frame (header, footer, fonts, colours). English only, never indexed, no Tetun twin.
// Styles are scoped under `.pt` in src/theme/styles/portal-theme.css, which only these pages load.
import ThemePage from './ThemePage.astro';
import '../theme/styles/portal-theme.css';
import { en } from '../i18n/en';

interface Props {
  title: string;
  description?: string;
  auth: { email: string; csrfToken: string };
}
const { title, description = title, auth } = Astro.props;
const p = en.portal;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/portal';
const tabs = [
  { href: '/portal', label: p.overview, here: path === '/portal' },
  {
    href: '/portal/profile?step=about',
    label: p.myPage,
    here: /^\/portal\/(profile|work|photos)/.test(path),
  },
  {
    href: '/portal/products',
    label: 'Products',
    here: /^\/portal\/products/.test(path),
  },
];
---

<ThemePage
  lang="en"
  title={`${title} · ${p.brand}`}
  description={description}
  rest={path}
  noindex
  realPage={false}
>
  <div class="pt">
    <div class="pt__bar">
      <nav class="pt__tabs" aria-label="Portal">
        {tabs.map((t) => (
          <a href={t.href} aria-current={t.here ? 'page' : undefined}>
            {t.label}
          </a>
        ))}
      </nav>
      <form class="pt__user" method="post" action="/portal/logout">
        <input type="hidden" name="csrf" value={auth.csrfToken} />
        <span>{auth.email}</span>
        <button type="submit" class="secondary">
          {p.signOut}
        </button>
      </form>
    </div>
    <slot />
  </div>
</ThemePage>
