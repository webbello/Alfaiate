---
// The signed-in tailor portal: one bar, four tabs, the account, one column of work.
// English only, never indexed, no Tetun twin.
import PortalShell from './PortalShell.astro';
import { en } from '../i18n/en';

interface Props {
  title: string;
  description?: string;
  auth: { email: string; csrfToken: string };
}
const { title, description = title, auth } = Astro.props;
const p = en.portal;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/portal';
const tabs = [
  { href: '/portal', label: p.overview, here: path === '/portal' },
  {
    href: '/portal/profile?step=about',
    label: p.myPage,
    here: /^\/portal\/(profile|work|photos)/.test(path),
  },
  {
    href: '/portal/products',
    label: p.productsTab,
    here: /^\/portal\/products/.test(path),
  },
  {
    href: '/portal/requests',
    label: p.requestsTab,
    here: /^\/portal\/requests/.test(path),
  },
];
---

<PortalShell title={`${title} · ${p.brand}`} description={description}>
  <header class="pt-bar" slot="bar">
    <div class="pt-bar__inner">
      <a class="pt-brand" href="/" aria-label="Alfaiate TL">
        <span class="brand-mark">
          <span class="brand-name">Alfaiate</span>{' '}
          <span class="brand-tl">TL</span>
        </span>
      </a>
      <nav class="pt-tabs" aria-label={p.portalLabel}>
        {tabs.map((t) => (
          <a href={t.href} aria-current={t.here ? 'page' : undefined}>
            {t.label}
          </a>
        ))}
      </nav>
      <div class="pt-account">
        <span class="pt-account__email">{auth.email}</span>
        <form class="pt-account__out" method="post" action="/portal/logout">
          <input type="hidden" name="csrf" value={auth.csrfToken} />
          <button type="submit">{p.signOut}</button>
        </form>
      </div>
    </div>
  </header>
  <slot />
</PortalShell>
