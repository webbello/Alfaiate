---
// The Handspark theme's page frame, with Alfaiate TL's head: our canonical and hreflang links, robots rules, language switch and security-header-safe scripts.
import { env } from 'cloudflare:workers';
import '../theme/styles/global.css';
import Header from '../theme/components/layout/Header.astro';
import Footer from '../theme/components/layout/Footer.astro';
import { SITE } from '../theme/config/site';
import { isEnabled, pathFor, twinPath, type Lang } from '../i18n/lang';
import { googleSiteVerification, siteConfig } from '../modules/config';
import { buildHead } from '../modules/seo/head';
import { serialiseJsonLd } from '../modules/seo/jsonld';
import { metaText } from '../modules/seo/meta';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, for example "/tailors/ana". */
  rest: string;
  noindex?: boolean;
  canonicalRest?: string;
  /** false for the 404 page: no canonical, no alternates, no language switch. */
  realPage?: boolean;
  /** Structured data blocks (JSON-LD), written only on pages search engines may index. */
  jsonLd?: object[];
  /** Absolute URL of the social sharing image. */
  ogImage?: string;
  /** Set on pages whose hero sits behind the header. */
  overlayHeader?: boolean;
  class?: string;
}
const {
  lang,
  title,
  description,
  rest,
  noindex = false,
  canonicalRest,
  realPage = true,
  jsonLd = [],
  ogImage,
  overlayHeader = false,
  class: className,
} = Astro.props;
const { siteUrl, languages, indexable } = siteConfig(env);
const head = buildHead({
  indexable,
  siteUrl,
  languages,
  lang,
  rest,
  noindex,
  canonicalRest,
  canonical: realPage,
});
const twin =
  realPage && isEnabled('tet', languages)
    ? twinPath(pathFor(lang, rest))
    : null;
const verification = googleSiteVerification(
  env as { GOOGLE_SITE_VERIFICATION?: string },
);
const pageTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {verification && (
      <meta name="google-site-verification" content={verification} />
    )}
    {head.robots && <meta name="robots" content={head.robots} />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {!head.robots && head.canonical && (
      <>
        <meta property="og:title" content={metaText(title, 200)} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={head.canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE.name} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card" content="summary_large_image" />
        {jsonLd.map((block) => (
          <script
            type="application/ld+json"
            is:inline
            set:html={serialiseJsonLd(block)}
          />
        ))}
      </>
    )}
    {head.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link
      rel="preload"
      href="/fonts/theme/Manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline src="/js-flag.js"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class:list={['page-wrapper', className]} id="top">
      <Header overlay={overlayHeader} twin={twin} />
      <main class="main-wrapper" id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import '../theme/scripts/index.ts';
    </script>
  </body>
</html>
