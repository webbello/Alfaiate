---
// The Handspark theme's page frame, with Alfaiate TL's head: our canonical and hreflang links, robots rules, language switch and security-header-safe scripts.
import { env } from 'cloudflare:workers';
import '../theme/styles/global.css';
import Header from '../theme/components/layout/Header.astro';
import Footer from '../theme/components/layout/Footer.astro';
import { SITE } from '../theme/config/site';
import { shellNav } from '../theme/config/nav';
import NewsletterSignup from '../theme/components/layout/NewsletterSignup.astro';
import { newsletterEnabled } from '../modules/newsletter';
import { dictionary } from '../i18n/public';
import { isEnabled, pathFor, twinPath, type Lang } from '../i18n/lang';
import {
  googleSiteVerification,
  siteWhatsapp,
  siteConfig,
  socialLinks,
} from '../modules/config';
import { whatsappLink } from '../modules/contact-links/whatsapp';
import { buildHead } from '../modules/seo/head';
import { serialiseJsonLd } from '../modules/seo/jsonld';
import { metaText } from '../modules/seo/meta';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, for example "/tailors/ana". */
  rest: string;
  noindex?: boolean;
  canonicalRest?: string;
  /** false for the 404 page: no canonical, no alternates, no language switch. */
  realPage?: boolean;
  /** Structured data blocks (JSON-LD), written only on pages search engines may index. */
  jsonLd?: object[];
  /** Absolute URL of the social sharing image. */
  ogImage?: string;
  /** On a tailor's page: that tailor's own buttons for the phone bar. */
  tailorBar?: { slug: string; whatsapp: string | null; phone: string | null; requestHref: string };
  /** Set on pages whose hero sits behind the header. */
  overlayHeader?: boolean;
  class?: string;
}
const {
  lang,
  title,
  description,
  rest,
  noindex = false,
  canonicalRest,
  realPage = true,
  jsonLd = [],
  ogImage,
  tailorBar,
  overlayHeader = false,
  class: className,
} = Astro.props;
const { siteUrl, languages, indexable } = siteConfig(env);
const head = buildHead({
  indexable,
  siteUrl,
  languages,
  lang,
  rest,
  noindex,
  canonicalRest,
  canonical: realPage,
});
const twin =
  realPage && isEnabled('tet', languages)
    ? twinPath(pathFor(lang, rest))
    : null;
const verification = googleSiteVerification(
  env as { GOOGLE_SITE_VERIFICATION?: string },
);
const t = dictionary(lang);
const shell = shellNav(t, lang);
const showNewsletter =
  newsletterEnabled(env as { NEWSLETTER_ENABLED?: string }) &&
  !['/newsletter', '/request', '/business', '/join'].some((p) =>
    rest.startsWith(p),
  );
// The quick-action bar for phones: never on the home page (it has its own calls to action), the forms (it could cover them), the legal pages,
// or the shop, where "Request a Tailor" is the wrong action and the bar covered Add to Cart (UX audit P6).
const showBar =
  rest !== '/' &&
  !['/request', '/business', '/join', '/privacy', '/terms', '/shop'].some((p) => rest.startsWith(p));
const ownerWhatsapp = siteWhatsapp(env as { SITE_WHATSAPP?: string });
const social = [
  ...socialLinks(
    env as {
      SOCIAL_FACEBOOK?: string;
      SOCIAL_INSTAGRAM?: string;
      SOCIAL_YOUTUBE?: string;
      SITE_WHATSAPP?: string;
    },
  ).map((s) => ({
    label: t.footer.social[s.name],
    href: s.href,
    icon: s.name,
  })),
];
const pageTitle = title.includes(t.siteName) ? title : `${title} · ${t.siteName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {verification && (
      <meta name="google-site-verification" content={verification} />
    )}
    {head.robots && <meta name="robots" content={head.robots} />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {!head.robots && head.canonical && (
      <>
        <meta property="og:title" content={metaText(title, 200)} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={head.canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={t.siteName} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card" content="summary_large_image" />
        {jsonLd.map((block) => (
          <script
            type="application/ld+json"
            is:inline
            set:html={serialiseJsonLd(block)}
          />
        ))}
      </>
    )}
    {head.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link
      rel="preload"
      href="/fonts/theme/Manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t.skipToContent}
    </a>
    <div class:list={['page-wrapper', className]} id="top">
      <Header
        overlay={overlayHeader}
        twin={twin}
        nav={shell.nav}
        mega={shell.mega}
        homeHref={shell.home}
        labels={{ main: t.nav.label, pages: t.nav.more, menu: t.nav.menu }}
        list={t.requestList}
        requestHref={pathFor(lang, '/request')}
        orderHref={pathFor(lang, '/order')}
      />
      <main class="main-wrapper" id="main">
        <slot />
      </main>
      <Footer
        groups={shell.footer}
        homeHref={shell.home}
        tagline={t.nav.tagline}
        closing={t.footer.closing}
        rights={t.footer.rights}
        note={t.disclaimer.short}
        siteName={t.siteName}
        social={social}
      >
        {showNewsletter && (
          <NewsletterSignup slot="newsletter" lang={lang} t={t} />
        )}
      </Footer>
    </div>
    {
      showBar && (
        <nav class="sticky-bar" aria-label={t.bar.label}>
          {tailorBar && (tailorBar.whatsapp || tailorBar.phone) ? (
            <>
              <a class="button w-inline-block" href={(tailorBar.whatsapp ?? tailorBar.phone)!} data-contact-channel={tailorBar.whatsapp ? 'whatsapp' : 'phone'} data-tailor={tailorBar.slug}>
                <div class="button-bg" />
                <div class="button-text">{tailorBar.whatsapp ? t.contact.whatsapp : t.contact.call}</div>
              </a>
              <a class="button w-inline-block is-shop" href={tailorBar.requestHref}>
                <div class="button-bg" />
                <div class="button-text">{t.profile.requestThis}</div>
              </a>
            </>
          ) : (
            <a class="button w-inline-block" href={pathFor(lang, '/request')}>
              <div class="button-bg" />
              <div class="button-text">{t.bar.ask}</div>
            </a>
          )}
          {ownerWhatsapp && !(tailorBar && (tailorBar.whatsapp || tailorBar.phone)) && (
            <a class="button w-inline-block is-shop" href={whatsappLink(ownerWhatsapp, t.bar.whatsappMessage)}>
              <div class="button-bg" />
              <div class="button-text">{t.bar.whatsapp}</div>
            </a>
          )}
        </nav>
      )
    }
    <script>
      import '../theme/scripts/index.ts';
    </script>
  </body>
</html>
