---
// The tailor sign-in and invite pages in the portal's own frame: the brand panel and the form card,
// with no shop header, cart or newsletter around them.
// English only, never indexed, no Tetun twin.
import PortalShell from './PortalShell.astro';
import { en } from '../i18n/en';

interface Props {
  title: string;
  description?: string;
  /** Kept for the pages that still pass their route; the portal shell is never indexed. */
  rest?: string;
}
const { title, description = title } = Astro.props;
const a = en.portal.auth;
---

<PortalShell title={`${title} · Alfaiate TL`} description={description}>
  <header class="pt-bar pt-bar--auth" slot="bar">
    <div class="pt-bar__inner">
      <a class="pt-brand" href="/" aria-label="Alfaiate TL">
        <span class="brand-mark">
          <span class="brand-name">Alfaiate</span>{' '}
          <span class="brand-tl">TL</span>
        </span>
      </a>
    </div>
  </header>
  <div class="auth">
    <aside class="auth__side" aria-label={a.sideLabel}>
      <span class="brand-mark brand-mark--footer" aria-hidden="true">
        <span class="brand-name">Alfaiate</span>
        <span class="brand-tl">TL</span>
      </span>
      <p class="auth__lead">{a.lead}</p>
      <ul class="auth__points">
        {a.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </aside>
    <section class="auth__card">
      <slot />
      <p class="auth__help">{a.help}</p>
    </section>
  </div>
</PortalShell>
