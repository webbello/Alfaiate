---
// The portal's own frame: a quiet bar, one column of work, a one-line footer. No shop header, no cart,
// no newsletter, no phone quick-action bar: the signed-in tailor is working, not browsing.
// English only, never indexed, no Tetun twin.
import '../theme/styles/global.css';
import '../theme/styles/portal-theme.css';
import { SITE } from '../theme/config/site';
import { en } from '../i18n/en';

interface Props {
  /** The full document title, already composed by the page's layout. */
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const p = en.portal;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link
      rel="preload"
      href="/fonts/theme/Manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/theme/LibreBaskerville-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="pt-stage legacy">
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <div class="pt-frame">
      <slot name="bar" />
      <main id="main" class="pt-main">
        <div class="pt">
          <slot />
        </div>
      </main>
      <footer class="pt-foot">
        <div class="pt-foot__inner">
          <p class="pt-foot__name">{SITE.name}</p>
          <nav class="pt-foot__links" aria-label={p.footerLabel}>
            <a href="/contact">{p.footerContact}</a>
            <a href="/privacy">{p.footerPrivacy}</a>
            <a href="/terms">{p.footerTerms}</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
