---
import { env } from 'cloudflare:workers';
import '../styles/site.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import NewsletterForm from '../components/newsletter/NewsletterForm.astro';
import { newsletterEnabled } from '../modules/newsletter';
import { dictionary } from '../i18n/public';
import { isEnabled, pathFor, twinPath, type Lang } from '../i18n/lang';
import {
  googleSiteVerification,
  siteConfig,
  siteWhatsapp,
  socialLinks,
} from '../modules/config';
import { whatsappLink } from '../modules/contact-links/whatsapp';
import { buildHead } from '../modules/seo/head';
import { serialiseJsonLd } from '../modules/seo/jsonld';
import { metaText } from '../modules/seo/meta';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. "/tailors/ana". */
  rest: string;
  noindex?: boolean;
  canonicalRest?: string;
  /** false for the 404 page: no canonical, no alternates, no language twin. */
  realPage?: boolean;
  /** Structured data blocks (JSON-LD). Only rendered on indexable pages. */
  jsonLd?: object[];
  /** Absolute URL of a permitted photo for Open Graph. */
  ogImage?: string;
  /** Full-width sections that bring their own container (the home page). */
  bare?: boolean;
  /** On a tailor's own page the phone bar is that tailor's contact, not the general request: ready-made links, left out when the tailor has none. */
  tailorBar?: {
    slug: string;
    whatsapp: string | null;
    phone: string | null;
    requestHref: string;
  };
  /** An image to fetch early because it is the largest thing on the first screen. */
  preloadImage?: { href: string; srcset: string; sizes: string };
}
const {
  lang,
  title,
  description,
  rest,
  noindex = false,
  canonicalRest,
  realPage = true,
  jsonLd = [],
  ogImage,
  bare = false,
  preloadImage,
  tailorBar,
} = Astro.props;
const t = dictionary(lang);
const { siteUrl, languages, indexable } = siteConfig(env);
const head = buildHead({
  indexable,
  siteUrl,
  languages,
  lang,
  rest,
  noindex,
  canonicalRest,
  canonical: realPage,
});
const showSwitch = realPage && isEnabled('tet', languages);
const twin = showSwitch ? twinPath(pathFor(lang, rest)) : null;
// The quick-action bar must never cover the forms, and the legal pages stay free of calls to action.
const showBar = !['/request', '/business', '/join', '/privacy', '/terms'].some(
  (p) => rest.startsWith(p),
);
const verification = googleSiteVerification(
  env as { GOOGLE_SITE_VERIFICATION?: string },
);
const social = socialLinks(
  env as {
    SOCIAL_FACEBOOK?: string;
    SOCIAL_INSTAGRAM?: string;
    SOCIAL_YOUTUBE?: string;
    SITE_WHATSAPP?: string;
  },
);
const ownerWhatsapp = siteWhatsapp(env as { SITE_WHATSAPP?: string });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {verification && (
      <meta name="google-site-verification" content={verification} />
    )}
    {head.robots && <meta name="robots" content={head.robots} />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {
      // Social tags and structured data only on pages that search engines may index.
      !head.robots && head.canonical && (
        <>
          <meta property="og:title" content={metaText(title, 200)} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={head.canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={t.siteName} />
          {ogImage && <meta property="og:image" content={ogImage} />}
          {jsonLd.map((block) => (
            <script
              type="application/ld+json"
              is:inline
              set:html={serialiseJsonLd(block)}
            />
          ))}
        </>
      )
    }
    <link
      rel="preload"
      href="/fonts/alfaiate-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
    {head.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <SiteHeader lang={lang} t={t} twin={twin} />
    <main id="main" class={bare ? 'main--bare' : undefined}>
      <slot />
    </main>
    <SiteFooter lang={lang} t={t} social={social}>
      {newsletterEnabled(env as { NEWSLETTER_ENABLED?: string }) &&
        !['/newsletter', '/request', '/business', '/join'].some((p) =>
          rest.startsWith(p),
        ) && (
          <div class="footer-col footer-col--wide">
            <h2 class="footer-col__title">{t.newsletter.heading}</h2>
            <p class="site-footer__note">{t.newsletter.body}</p>
            <NewsletterForm lang={lang} t={t} />
          </div>
        )}
    </SiteFooter>
    {showBar && (
      <nav class="sticky-bar" aria-label={t.bar.label}>
        {tailorBar && (tailorBar.whatsapp || tailorBar.phone) ? (
          <>
            {tailorBar.whatsapp ? (
              <a
                class="button"
                href={tailorBar.whatsapp}
                data-contact-channel="whatsapp"
                data-tailor={tailorBar.slug}
              >
                {t.contact.whatsapp}
              </a>
            ) : (
              <a
                class="button"
                href={tailorBar.phone!}
                data-contact-channel="phone"
                data-tailor={tailorBar.slug}
              >
                {t.contact.call}
              </a>
            )}
            <a class="button button--secondary" href={tailorBar.requestHref}>
              {t.profile.requestThis}
            </a>
          </>
        ) : (
          <a class="button" href={pathFor(lang, '/request')}>
            {t.bar.ask}
          </a>
        )}
        {ownerWhatsapp &&
          !(tailorBar && (tailorBar.whatsapp || tailorBar.phone)) && (
            <a
              class="button button--secondary"
              href={whatsappLink(ownerWhatsapp, t.bar.whatsappMessage)}
            >
              {t.bar.whatsapp}
            </a>
          )}
      </nav>
    )}
  </body>
</html>
