---
import { env } from 'cloudflare:workers';
import '../styles/site.css';
import { dictionary } from '../i18n/public';
import { isEnabled, pathFor, twinPath, type Lang } from '../i18n/lang';
import { siteConfig, siteWhatsapp } from '../modules/config';
import { whatsappLink } from '../modules/contact-links/whatsapp';
import { buildHead } from '../modules/seo/head';
import { serialiseJsonLd } from '../modules/seo/jsonld';
import { metaText } from '../modules/seo/meta';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. "/tailors/ana". */
  rest: string;
  noindex?: boolean;
  canonicalRest?: string;
  /** false for the 404 page: no canonical, no alternates, no language twin. */
  realPage?: boolean;
  /** Structured data blocks (JSON-LD). Only rendered on indexable pages. */
  jsonLd?: object[];
  /** Absolute URL of a permitted photo for Open Graph. */
  ogImage?: string;
}
const {
  lang,
  title,
  description,
  rest,
  noindex = false,
  canonicalRest,
  realPage = true,
  jsonLd = [],
  ogImage,
} = Astro.props;
const t = dictionary(lang);
const { siteUrl, languages, indexable } = siteConfig(env);
const head = buildHead({
  indexable,
  siteUrl,
  languages,
  lang,
  rest,
  noindex,
  canonicalRest,
  canonical: realPage,
});
const showSwitch = realPage && isEnabled('tet', languages);
const twin = showSwitch ? twinPath(pathFor(lang, rest)) : null;
// The quick-action bar must never cover the forms, and the legal pages stay free of calls to action.
const showBar = !['/request', '/privacy', '/terms'].some((p) =>
  rest.startsWith(p),
);
const ownerWhatsapp = siteWhatsapp(env as { SITE_WHATSAPP?: string });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {head.robots && <meta name="robots" content={head.robots} />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {
      // Social tags and structured data only on pages that search engines may index.
      !head.robots && head.canonical && (
        <>
          <meta property="og:title" content={metaText(title, 200)} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={head.canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={t.siteName} />
          {ogImage && <meta property="og:image" content={ogImage} />}
          {jsonLd.map((block) => (
            <script
              type="application/ld+json"
              is:inline
              set:html={serialiseJsonLd(block)}
            />
          ))}
        </>
      )
    }
    {head.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipToContent}
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href={pathFor(lang, '/')}>
          {t.siteName}
        </a>
        <nav class="site-nav" aria-label={t.nav.label}>
          <a href={pathFor(lang, '/')}>{t.nav.home}</a>
          <a href={pathFor(lang, '/tailors')}>{t.nav.tailors}</a>
          <a href={pathFor(lang, '/how-it-works')}>{t.nav.how}</a>
          {twin && (
            <a
              class="lang-switch"
              href={twin.path}
              lang={twin.lang}
              hreflang={twin.lang}
            >
              {t.language[twin.lang]}
            </a>
          )}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>{t.disclaimer.short}</p>
        <nav aria-label={t.footer.label} class="footer-nav">
          <a href={pathFor(lang, '/about')}>{t.footer.about}</a>
          <a href={pathFor(lang, '/privacy')}>{t.footer.privacy}</a>
          <a href={pathFor(lang, '/terms')}>{t.footer.terms}</a>
        </nav>
      </div>
    </footer>
    {showBar && (
      <nav class="sticky-bar" aria-label={t.bar.label}>
        <a class="button" href={pathFor(lang, '/request')}>
          {t.bar.ask}
        </a>
        {ownerWhatsapp && (
          <a
            class="button button--secondary"
            href={whatsappLink(ownerWhatsapp, t.bar.whatsappMessage)}
          >
            {t.bar.whatsapp}
          </a>
        )}
      </nav>
    )}
  </body>
</html>
