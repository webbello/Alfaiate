---
import { env } from 'cloudflare:workers';
import { responseWindow } from '../modules/config';
import { fill } from '../i18n/public';
import PublicLayout from '../layouts/PublicLayout.astro';
import { dictionary } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';

interface Props {
  lang: Lang;
  reference: string;
}
const { lang, reference } = Astro.props;
const t = dictionary(lang);
const when = responseWindow(
  env as { RESPONSE_WINDOW_EN?: string; RESPONSE_WINDOW_TET?: string },
  lang,
);
const j = t.join;
---

<PublicLayout
  lang={lang}
  title={`${j.thanksTitle} · ${t.siteName}`}
  description={j.thanksBody}
  rest="/join/thanks"
  noindex
>
  <h1>{j.thanksHeading}</h1>
  <p>{t.request.reference}</p>
  <p class="reference">
    <strong>{reference}</strong>
  </p>
  <p>{t.request.keepCode}</p>
  <p class="notice" role="note">
    {j.notListing}
  </p>
  <p>{j.thanksBody}</p>
  {when && <p>{fill(t.request.responseLine, { when })}</p>}
  <p>
    <a class="button" href={pathFor(lang, '/')}>
      {t.nav.home}
    </a>
  </p>
</PublicLayout>
