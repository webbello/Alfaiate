---
import { env } from 'cloudflare:workers';
import PublicLayout from '../layouts/PublicLayout.astro';
import '../styles/home.css';
import HeroSection from '../components/home/HeroSection.astro';
import ServiceCategories from '../components/home/ServiceCategories.astro';
import FeaturedTailors from '../components/home/FeaturedTailors.astro';
import CraftsmanshipSection from '../components/home/CraftsmanshipSection.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import PromotionalBanners from '../components/home/PromotionalBanners.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import FinalCallToAction from '../components/home/FinalCallToAction.astro';
import { scene } from '../components/home/images';
import { dictionary } from '../i18n/public';
import { type Lang } from '../i18n/lang';
import {
  requireBindings,
  siteConfig,
  socialLinks,
  testimonialPlaceholders,
} from '../modules/config';

type SocialEnv = Parameters<typeof socialLinks>[0];
import { websiteJsonLd } from '../modules/seo/jsonld';
import {
  listActiveCategories,
  listPublished,
} from '../modules/directory/queries';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionary(lang);
const { DB } = requireBindings(env);
const [categories, { tailors }] = await Promise.all([
  listActiveCategories(DB, { onlyWithTailors: true }),
  listPublished(DB, { category: undefined, area: undefined, homeVisit: false }),
]);
const hero = scene('hero');
---

<PublicLayout
  lang={lang}
  title={`${t.home.title} · ${t.siteName}`}
  description={t.home.description}
  rest="/"
  bare
  preloadImage={{
    href: hero.src,
    srcset: hero.srcset,
    sizes: '(min-width: 64rem) 58vw, 100vw',
  }}
  jsonLd={websiteJsonLd(
    siteConfig(env).siteUrl,
    t.siteName,
    lang,
    socialLinks(env as SocialEnv)
      .filter((s) => s.name !== 'whatsapp')
      .map((s) => s.href),
  )}
>
  <HeroSection lang={lang} t={t} />
  <ServiceCategories
    lang={lang}
    t={t}
    live={new Set(categories.map((c) => c.slug))}
  />
  <FeaturedTailors lang={lang} t={t} tailors={tailors.slice(0, 8)} />
  <CraftsmanshipSection lang={lang} t={t} />
  <HowItWorks t={t} />
  <PromotionalBanners lang={lang} t={t} />
  <TestimonialsSection
    t={t}
    placeholders={testimonialPlaceholders(
      env as { SHOW_TESTIMONIAL_PLACEHOLDERS?: string },
    )}
  />
  <FinalCallToAction lang={lang} t={t} />
</PublicLayout>

<script>
  // Carousel arrows (featured tailors): shown only when the row overflows; scrolling itself is native, so touch and keyboard work without this.
  for (const controls of document.querySelectorAll<HTMLElement>(
    '[data-carousel-controls]',
  )) {
    const track = document.getElementById(
      controls.dataset.carouselControls ?? '',
    );
    if (!track || track.scrollWidth <= track.clientWidth + 4) continue;
    controls.hidden = false;
    for (const button of controls.querySelectorAll<HTMLButtonElement>('button'))
      button.addEventListener('click', () =>
        track.scrollBy({
          left: Number(button.dataset.dir) * track.clientWidth * 0.9,
          behavior: 'smooth',
        }),
      );
  }
</script>
