---
import PublicLayout from '../layouts/PublicLayout.astro';
import { dictionary, fill } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';
import type { Outcome } from '../modules/enquiry/submit';
import type { Field } from '../modules/enquiry/schema';

interface Props {
  lang: Lang;
  outcome: Extract<Outcome, { kind: 'form' | 'message' }>;
  /** 'business' renders the group-order form at /business (FR-ENQ-09). */
  kind?: 'request' | 'business';
}
const { lang, outcome, kind = 'request' } = Astro.props;
const t = dictionary(lang);
const r = t.request;
const b = t.business;
const business = kind === 'business';
const path = business ? '/business' : '/request';
const title = business ? b.title : r.title;
const heading = business ? b.heading : r.heading;
const intro = business ? b.intro : r.intro;
const view = outcome.kind === 'form' ? outcome.view : null;
const messageHeading =
  outcome.kind === 'message'
    ? outcome.which === 'limited'
      ? r.limitedHeading
      : outcome.which === 'forbidden'
        ? r.forbiddenHeading
        : r.failedHeading
    : '';
const messageBody =
  outcome.kind === 'message'
    ? outcome.which === 'limited'
      ? r.limitedBody
      : outcome.which === 'forbidden'
        ? r.forbiddenBody
        : r.failedBody
    : '';
const values = view?.values;
const errors = view?.errors ?? {};
const labels: Record<Field, string> = {
  name: r.name,
  phone: r.phone,
  channel: r.channel,
  category: r.category,
  service: r.service,
  area: r.area,
  area_text: r.areaText,
  when: r.when,
  notes: r.notes,
  organisation: b.organisation,
  group_size: b.groupSize,
  consent: r.consentLegend,
};
const message = (field: Field) => {
  const key = errors[field];
  if (field === 'consent') return r.errorConsent;
  if (field === 'phone' && key === 'invalid') return r.errorPhone;
  return key === 'required'
    ? r.errorRequired
    : key === 'invalid'
      ? r.errorInvalid
      : r.errorTooLong;
};
const failing = (Object.keys(errors) as Field[]).filter((f) => errors[f]);
const describedBy = (field: Field, hint?: string) =>
  [hint, errors[field] ? `${field}-error` : undefined]
    .filter(Boolean)
    .join(' ') || undefined;
const invalid = (field: Field) => (errors[field] ? 'true' : undefined);
---

<PublicLayout
  lang={lang}
  title={`${outcome.kind === 'message' ? messageHeading : title} · ${t.siteName}`}
  description={intro}
  rest={path}
  noindex
>
  {outcome.kind === 'message' ? (
    <>
      <h1>{messageHeading}</h1>
      <p>{messageBody}</p>
      <p>
        {outcome.which === 'forbidden' && (
          <a class="button" href={pathFor(lang, '/request')}>
            {r.heading}
          </a>
        )}
        <a class="button button--secondary" href={pathFor(lang, '/tailors')}>
          {r.browse}
        </a>
      </p>
    </>
  ) : (
    view &&
    values && (
      <>
        <h1>{heading}</h1>
        <p class="request__intro">{intro}</p>
        <ol class="how" aria-label={r.howLabel}>
          <li>{r.how1}</li>
          <li>{r.how2}</li>
          <li>{r.how3}</li>
        </ol>
        <p class="hint request__promise">{r.promise}</p>
        {view.tailor && (
          <p class="notice">{fill(r.fromTailor, { name: view.tailor.name })}</p>
        )}
        {(failing.length > 0 || view.formError) && (
          <div class="error-summary" role="alert" tabindex="-1" autofocus>
            <h2>{r.summaryHeading}</h2>
            <ul>
              {view.formError === 'too_fast' && <li>{r.tooFast}</li>}
              {view.formError === 'expired' && <li>{r.expired}</li>}
              {failing.map((f) => (
                <li>
                  <a href={`#${f}`}>
                    {labels[f]}: {message(f)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <form class="request" method="post" action={pathFor(lang, path)}>
          <input type="hidden" name="form_token" value={view.token} />
          {view.tailor && (
            <input type="hidden" name="tailor" value={view.tailor.slug} />
          )}
          <div class="hp" aria-hidden="true">
            <label for="extra_info">Leave this empty</label>
            <input
              type="text"
              id="extra_info"
              name="extra_info"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <fieldset class="step">
            <legend>{r.stepOne}</legend>
            {business && (
              <>
                <div class="field">
                  <label for="organisation">{b.organisation}</label>
                  <input
                    type="text"
                    id="organisation"
                    name="organisation"
                    value={values.organisation}
                    autocomplete="organization"
                    maxlength="100"
                    required
                    aria-invalid={invalid('organisation')}
                    aria-describedby={describedBy('organisation')}
                  />
                  {errors.organisation && (
                    <p class="error" id="organisation-error">
                      {message('organisation')}
                    </p>
                  )}
                </div>
                <div class="field">
                  <label for="group_size">{b.groupSize}</label>
                  <p class="hint" id="group_size-hint">
                    {b.groupSizeHint}
                  </p>
                  <input
                    type="text"
                    id="group_size"
                    name="group_size"
                    value={values.group_size}
                    maxlength="40"
                    aria-invalid={invalid('group_size')}
                    aria-describedby={describedBy(
                      'group_size',
                      'group_size-hint',
                    )}
                  />
                  {errors.group_size && (
                    <p class="error" id="group_size-error">
                      {message('group_size')}
                    </p>
                  )}
                </div>
              </>
            )}
            <fieldset
              class="field"
              id="category"
              aria-describedby={describedBy('category')}
            >
              <legend>{r.category}</legend>
              <div class="chip-choices">
                <label class="chip-choice" for="category-none">
                  <input
                    type="radio"
                    id="category-none"
                    name="category"
                    value=""
                    checked={!values.category}
                  />
                  <span>{r.notSure}</span>
                </label>
                {view.categories.map((x) => (
                  <label class="chip-choice" for={`category-${x.id}`}>
                    <input
                      type="radio"
                      id={`category-${x.id}`}
                      name="category"
                      value={String(x.id)}
                      checked={values.category === String(x.id)}
                    />
                    <span>{x.name}</span>
                  </label>
                ))}
              </div>
              {errors.category && (
                <p class="error" id="category-error">
                  {message('category')}
                </p>
              )}
            </fieldset>
            <div class="field">
              <label for="service">{r.service}</label>
              <input
                type="text"
                id="service"
                name="service"
                value={values.service}
                maxlength="200"
                aria-invalid={invalid('service')}
                aria-describedby={describedBy('service')}
              />
              {errors.service && (
                <p class="error" id="service-error">
                  {message('service')}
                </p>
              )}
            </div>
            <fieldset
              class="field"
              id="area"
              aria-describedby={describedBy('area')}
            >
              <legend>{r.area}</legend>
              <div class="chip-choices">
                <label class="chip-choice" for="area-none">
                  <input
                    type="radio"
                    id="area-none"
                    name="area"
                    value=""
                    checked={!values.area}
                  />
                  <span>{r.notSure}</span>
                </label>
                {view.areas.map((x) => (
                  <label class="chip-choice" for={`area-${x.id}`}>
                    <input
                      type="radio"
                      id={`area-${x.id}`}
                      name="area"
                      value={String(x.id)}
                      checked={values.area === String(x.id)}
                    />
                    <span>{x.name}</span>
                  </label>
                ))}
                <label class="chip-choice" for="area-other">
                  <input
                    type="radio"
                    id="area-other"
                    name="area"
                    value="other"
                    checked={values.area === 'other'}
                  />
                  <span>{r.areaOther}</span>
                </label>
              </div>
              {errors.area && (
                <p class="error" id="area-error">
                  {message('area')}
                </p>
              )}
            </fieldset>
            <div class="field field--other">
              <label for="area_text">{r.areaText}</label>
              <input
                type="text"
                id="area_text"
                name="area_text"
                value={values.area_text}
                maxlength="100"
                aria-invalid={invalid('area_text')}
                aria-describedby={describedBy('area_text')}
              />
              {errors.area_text && (
                <p class="error" id="area_text-error">
                  {message('area_text')}
                </p>
              )}
            </div>
            <details
              class="more"
              open={Boolean(
                values.when || values.notes || errors.when || errors.notes,
              )}
            >
              <summary>{r.more}</summary>
              <div class="field">
                <label for="when">{r.when}</label>
                <p class="hint" id="when-hint">
                  {r.whenHint}
                </p>
                <input
                  type="text"
                  id="when"
                  name="when"
                  value={values.when}
                  maxlength="100"
                  aria-invalid={invalid('when')}
                  aria-describedby={describedBy('when', 'when-hint')}
                />
                {errors.when && (
                  <p class="error" id="when-error">
                    {message('when')}
                  </p>
                )}
              </div>
              <div class="field">
                <label for="notes">{r.notes}</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  maxlength="1000"
                  aria-invalid={invalid('notes')}
                  aria-describedby={describedBy('notes')}
                >{values.notes}</textarea>
                {errors.notes && (
                  <p class="error" id="notes-error">
                    {message('notes')}
                  </p>
                )}
              </div>
            </details>
          </fieldset>
          <fieldset class="step">
            <legend>{r.stepTwo}</legend>
            <div class="field-row">
              <div class="field">
                <label for="name">{r.name}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  value={values.name}
                  autocomplete="name"
                  maxlength="100"
                  required
                  aria-invalid={invalid('name')}
                  aria-describedby={describedBy('name')}
                />
                {errors.name && (
                  <p class="error" id="name-error">
                    {message('name')}
                  </p>
                )}
              </div>

              <div class="field">
                <label for="phone">{r.phone}</label>
                <p class="hint" id="phone-hint">
                  {r.phoneHint}
                </p>
                <input
                  type="tel"
                  inputmode="tel"
                  id="phone"
                  name="phone"
                  value={values.phone}
                  autocomplete="tel"
                  maxlength="40"
                  required
                  aria-invalid={invalid('phone')}
                  aria-describedby={describedBy('phone', 'phone-hint')}
                />
                {errors.phone && (
                  <p class="error" id="phone-error">
                    {message('phone')}
                  </p>
                )}
              </div>
            </div>
            <fieldset
              class="field"
              id="channel"
              aria-describedby={describedBy('channel')}
            >
              <legend>{r.channel}</legend>
              <div class="chip-choices">
                {(
                  [
                    ['whatsapp', r.channelWhatsapp],
                    ['phone', r.channelPhone],
                    ['either', r.channelEither],
                  ] as const
                ).map(([value, text]) => (
                  <label class="chip-choice" for={`channel-${value}`}>
                    <input
                      type="radio"
                      id={`channel-${value}`}
                      name="channel"
                      value={value}
                      checked={(values.channel || 'either') === value}
                      required
                    />
                    <span>{text}</span>
                  </label>
                ))}
              </div>
              {errors.channel && (
                <p class="error" id="channel-error">
                  {message('channel')}
                </p>
              )}
            </fieldset>

            <fieldset class="field">
              <legend>{r.consentLegend}</legend>
              <label class="choice" for="consent">
                <input
                  type="checkbox"
                  id="consent"
                  name="consent"
                  value="yes"
                  required
                  aria-invalid={invalid('consent')}
                  aria-describedby={describedBy('consent')}
                />
                {r.consent}
              </label>
              {errors.consent && (
                <p class="error" id="consent-error">
                  {message('consent')}
                </p>
              )}
              <p>
                <a href={pathFor(lang, '/privacy')}>{r.privacyLink}</a>
              </p>
            </fieldset>
          </fieldset>
          <p class="notice" role="note">
            <strong>{t.home.noteLabel}:</strong> {r.notBooking}
          </p>
          <p>
            <button class="button" type="submit">
              {r.submit}
            </button>
          </p>
        </form>
      </>
    )
  )}
</PublicLayout>
