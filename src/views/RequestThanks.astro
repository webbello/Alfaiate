---
import { env } from 'cloudflare:workers';
import { orderWhatsapp, responseWindow, siteWhatsapp } from '../modules/config';
import { whatsappLink } from '../modules/contact-links/whatsapp';
import { fill } from '../i18n/public';
import ThemePage from '../layouts/ThemePage.astro';
import { dictionary } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';

interface Props {
  lang: Lang;
  reference: string;
}
const { lang, reference } = Astro.props;
const t = dictionary(lang);
const when = responseWindow(
  env as { RESPONSE_WINDOW_EN?: string; RESPONSE_WINDOW_TET?: string },
  lang,
);
const r = t.request;
// "Message us your code": the site's WhatsApp number (else the shop order number), the message holding only the reference code. No number set, no button.
const number =
  siteWhatsapp(env as { SITE_WHATSAPP?: string }) ??
  orderWhatsapp(env as { ORDER_WHATSAPP?: string; SITE_WHATSAPP?: string });
const waHref = number
  ? whatsappLink(number, fill(r.thanksWhatsAppMessage, { code: reference }))
  : null;
---

<ThemePage
  lang={lang}
  title={`${r.thanksTitle} · ${t.siteName}`}
  description={r.thanksBody}
  rest="/request/thanks"
  noindex
>
  <h1>{r.thanksHeading}</h1>
  <p>{r.reference}</p>
  <p class="reference">
    <strong>{reference}</strong>
  </p>
  <p>{r.keepCode}</p>
  <p class="notice" role="note">
    <strong>{t.home.noteLabel}:</strong> {r.notBooking}
  </p>
  <p>{r.thanksBody}</p>
  <ol class="how request__next" aria-label={r.nextLabel}>
    <li>{r.next1}</li>
    <li>{r.next2}</li>
    <li>{r.next3}</li>
  </ol>
  {when && <p>{fill(t.request.responseLine, { when })}</p>}
  <p class="thanks-actions">
    {
      waHref && (
        <a class="button" href={waHref} target="_blank" rel="noopener noreferrer">
          {r.thanksWhatsApp}
        </a>
      )
    }
    <a class={waHref ? 'button button--secondary' : 'button'} href={pathFor(lang, '/tailors')}>
      {r.browse}
    </a>
  </p>
</ThemePage>
