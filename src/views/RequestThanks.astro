---
import { env } from 'cloudflare:workers';
import { responseWindow } from '../modules/config';
import { fill } from '../i18n/public';
import ThemePage from '../layouts/ThemePage.astro';
import { dictionary } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';

interface Props {
  lang: Lang;
  reference: string;
}
const { lang, reference } = Astro.props;
const t = dictionary(lang);
const when = responseWindow(
  env as { RESPONSE_WINDOW_EN?: string; RESPONSE_WINDOW_TET?: string },
  lang,
);
const r = t.request;
---

<ThemePage
  lang={lang}
  title={`${r.thanksTitle} · ${t.siteName}`}
  description={r.thanksBody}
  rest="/request/thanks"
  noindex
>
  <h1>{r.thanksHeading}</h1>
  <p>{r.reference}</p>
  <p class="reference">
    <strong>{reference}</strong>
  </p>
  <p>{r.keepCode}</p>
  <p class="notice" role="note">
    <strong>{t.home.noteLabel}:</strong> {r.notBooking}
  </p>
  <p>{r.thanksBody}</p>
  <ol class="how request__next" aria-label={r.nextLabel}>
    <li>{r.next1}</li>
    <li>{r.next2}</li>
    <li>{r.next3}</li>
  </ol>
  {when && <p>{fill(t.request.responseLine, { when })}</p>}
  <p>
    <a class="button" href={pathFor(lang, '/tailors')}>
      {r.browse}
    </a>
  </p>
</ThemePage>
