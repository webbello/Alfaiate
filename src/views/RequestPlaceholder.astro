---
import PublicLayout from '../layouts/PublicLayout.astro';
import { dictionary } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionary(lang);
---

<!-- Placeholder until Phase 5: no form, nothing is collected. Not indexed. -->
<PublicLayout
  lang={lang}
  title={`${t.request.title} · ${t.siteName}`}
  description={t.request.body}
  rest="/request"
  noindex
>
  <h1>{t.request.heading}</h1>
  <p>{t.request.body}</p>
  <p>
    <a class="button" href={pathFor(lang, '/tailors')}>
      {t.request.browse}
    </a>
  </p>
</PublicLayout>
