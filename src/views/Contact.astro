---
import { env } from 'cloudflare:workers';
import ThemePage from '../layouts/ThemePage.astro';
import { dictionary, fill } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';
import {
  joinEnabled,
  orderWhatsapp,
  responseWindow,
  siteWhatsapp,
} from '../modules/config';
import { whatsappLink } from '../modules/contact-links/whatsapp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionary(lang);
const c = t.contactPage;
const settings = env as {
  SITE_WHATSAPP?: string;
  ORDER_WHATSAPP?: string;
  JOIN_ENABLED?: string;
  RESPONSE_WINDOW_EN?: string;
  RESPONSE_WINDOW_TET?: string;
};
// A direct way to reach the business (UX audit P8): the site's WhatsApp number, else the shop order number, as on the request confirmation page.
const whatsapp = siteWhatsapp(settings) ?? orderWhatsapp(settings);
const when = responseWindow(settings, lang);
---

<ThemePage
  lang={lang}
  title={`${c.title} · ${t.siteName}`}
  description={c.intro}
  rest="/contact"
>
  <div class="prose">
    <h1>{c.heading}</h1>
    <p class="lead">{c.intro}</p>
    <p class="actions">
      <a class="button" href={pathFor(lang, '/request')}>
        {c.requestLink}
      </a>
    </p>
    {whatsapp && (
      <section aria-labelledby="contact-whatsapp">
        <h2 id="contact-whatsapp">{c.whatsappHeading}</h2>
        <p>{c.whatsappBody}</p>
        {when && <p>{fill(t.request.responseLine, { when })}</p>}
        <p>
          <a
            class="button button--secondary"
            href={whatsappLink(whatsapp, t.bar.whatsappMessage)}
          >
            {c.whatsappLink}
          </a>
        </p>
      </section>
    )}
    {joinEnabled(settings) && (
      <section aria-labelledby="contact-tailors">
        <h2 id="contact-tailors">{c.tailorsHeading}</h2>
        <p>{c.tailorsBody}</p>
        <p>
          <a class="button button--secondary" href={pathFor(lang, '/join')}>
            {c.tailorsLink}
          </a>
        </p>
      </section>
    )}
  </div>
</ThemePage>
