---
import { env } from 'cloudflare:workers';
import PublicLayout from '../layouts/PublicLayout.astro';
import TailorCard from '../components/TailorCard.astro';
import { dictionary, fill } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';
import { requireBindings } from '../modules/config';
import {
  directoryQuery,
  parseDirectoryFilters,
} from '../modules/directory/filters';
import {
  listActiveAreas,
  listActiveCategories,
  listPublished,
} from '../modules/directory/queries';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionary(lang);
const { DB } = requireBindings(env);
const filters = parseDirectoryFilters(Astro.url.searchParams);
const active = directoryQuery(filters) !== '';
const [{ tailors, truncated }, categories, areas] = await Promise.all([
  listPublished(DB, filters),
  listActiveCategories(DB, { onlyWithTailors: true }),
  listActiveAreas(DB, { onlyWithTailors: true }),
]);
const action = pathFor(lang, '/tailors');
// Any query string (filters or junk) makes this a variant of the plain list: not indexed, canonical points at /tailors.
const variant = Astro.url.search !== '';
---

<PublicLayout
  lang={lang}
  title={`${t.directory.title} · ${t.siteName}`}
  description={t.directory.intro}
  rest="/tailors"
  noindex={variant}
>
  <h1>{t.directory.heading}</h1>
  <p class="lead">{t.directory.intro}</p>
  <p class="notice" role="note">
    <strong>{t.home.noteLabel}:</strong> {t.disclaimer.short}
  </p>
  <p class="actions">
    <a class="button" href={pathFor(lang, '/request')}>
      {t.cta.requestHome}
    </a>
  </p>

  <form class="filters" method="get" action={action}>
    <h2>{t.directory.filtersHeading}</h2>
    <p>
      <label for="search">{t.directory.search}</label>
      <input
        type="search"
        id="search"
        name="q"
        value={filters.q ?? ''}
        maxlength="60"
        autocomplete="off"
      />
    </p>
    <p>
      <label for="filter-category">{t.directory.category}</label>
      <select id="filter-category" name="category">
        <option value="">{t.directory.any}</option>
        {categories.map((c) => (
          <option value={c.slug} selected={filters.category === c.slug}>
            {c.name}
          </option>
        ))}
      </select>
    </p>
    <p>
      <label for="filter-area">{t.directory.area}</label>
      <select id="filter-area" name="area">
        <option value="">{t.directory.any}</option>
        {areas.map((a) => (
          <option value={a.slug} selected={filters.area === a.slug}>
            {a.name}
          </option>
        ))}
      </select>
    </p>
    <p>
      <label class="check">
        <input
          type="checkbox"
          name="home_visit"
          value="1"
          checked={filters.homeVisit}
        />{' '}
        {t.directory.homeVisit}
      </label>
    </p>
    <p class="actions">
      <button class="button" type="submit">
        {t.directory.apply}
      </button>
      {active && (
        <a class="button button--secondary" href={action}>
          {t.directory.clear}
        </a>
      )}
    </p>
  </form>

  <p role="status" class="count">
    {fill(t.directory.found, { count: tailors.length })}
  </p>

  {tailors.length === 0 ? (
    <section aria-labelledby="empty">
      <h2 id="empty">{t.directory.emptyHeading}</h2>
      <p>{t.directory.emptyBody}</p>
      <p class="actions">
        {active && (
          <a class="button button--secondary" href={action}>
            {t.directory.clear}
          </a>
        )}
        <a class="button" href={pathFor(lang, '/request')}>
          {t.cta.requestHome}
        </a>
      </p>
    </section>
  ) : (
    <ul class="grid">
      {tailors.map((tailor) => (
        <li>
          <TailorCard lang={lang} tailor={tailor} />
        </li>
      ))}
    </ul>
  )}
  {truncated && <p class="notice">{t.directory.truncated}</p>}
</PublicLayout>
