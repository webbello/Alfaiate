---
import { env } from 'cloudflare:workers';
import PublicLayout from '../layouts/PublicLayout.astro';
import TailorCard from '../components/TailorCard.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { dictionary, fill } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';
import { requireBindings } from '../modules/config';
import {
  directoryQuery,
  parseDirectoryFilters,
} from '../modules/directory/filters';
import {
  listActiveAreas,
  listActiveCategories,
  listPublished,
} from '../modules/directory/queries';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dictionary(lang);
const { DB } = requireBindings(env);
const filters = parseDirectoryFilters(Astro.url.searchParams);
const active = directoryQuery(filters) !== '';
const [{ tailors, truncated }, categories, areas] = await Promise.all([
  listPublished(DB, filters),
  listActiveCategories(DB, { onlyWithTailors: true }),
  listActiveAreas(DB, { onlyWithTailors: true }),
]);
const action = pathFor(lang, '/tailors');
// Removable chips for the filters in force: each link drops exactly one filter.
type Chip = { label: string; clear: Partial<typeof filters> };
const chips = (
  [
    filters.q && { label: `“${filters.q}”`, clear: { q: undefined } },
    filters.category && {
      label:
        categories.find((c) => c.slug === filters.category)?.name ??
        filters.category,
      clear: { category: undefined },
    },
    filters.area && {
      label: areas.find((a) => a.slug === filters.area)?.name ?? filters.area,
      clear: { area: undefined },
    },
    filters.homeVisit && {
      label: t.directory.homeVisit,
      clear: { homeVisit: false },
    },
  ] as (Chip | false | undefined | '')[]
).filter((c): c is Chip => Boolean(c));
// Any query string (filters or junk) makes this a variant of the plain list: not indexed, canonical points at /tailors.
const variant = Astro.url.search !== '';
---

<PublicLayout
  lang={lang}
  title={`${t.directory.title} · ${t.siteName}`}
  description={t.directory.intro}
  rest="/tailors"
  noindex={variant}
>
  <h1>{t.directory.heading}</h1>
  <p class="lead lead--tight">{t.directory.intro}</p>
  <p class="notice notice--compact" role="note">
    <strong>{t.home.noteLabel}:</strong> {t.disclaimer.short}
  </p>

  <form class="filters" method="get" action={action}>
    <h2 class="filters__title">{t.directory.filtersHeading}</h2>
    <p class="filters__q">
      <label for="search">{t.directory.search}</label>
      <input
        type="search"
        id="search"
        name="q"
        value={filters.q ?? ''}
        maxlength="60"
        autocomplete="off"
      />
    </p>
    <p>
      <label for="filter-category">{t.directory.category}</label>
      <select id="filter-category" name="category">
        <option value="">{t.directory.any}</option>
        {categories.map((c) => (
          <option value={c.slug} selected={filters.category === c.slug}>
            {c.name}
          </option>
        ))}
      </select>
    </p>
    <p>
      <label for="filter-area">{t.directory.area}</label>
      <select id="filter-area" name="area">
        <option value="">{t.directory.any}</option>
        {areas.map((a) => (
          <option value={a.slug} selected={filters.area === a.slug}>
            {a.name}
          </option>
        ))}
      </select>
    </p>
    <p class="filters__check">
      <label class="check">
        <input
          type="checkbox"
          name="home_visit"
          value="1"
          checked={filters.homeVisit}
        />{' '}
        {t.directory.homeVisit}
      </label>
    </p>
    <p class="filters__actions">
      <button class="button filters__apply" type="submit">
        {t.directory.apply}
      </button>
      {active && (
        <a class="button button--secondary" href={action}>
          {t.directory.clear}
        </a>
      )}
    </p>
  </form>

  <div class="toolbar">
    <p role="status" class="count" data-template={t.directory.found}>
      {fill(t.directory.found, { count: tailors.length })}
    </p>
    {chips.length > 0 && (
      <ul class="chips chips--compact" role="list">
        {chips.map((c) => (
          <li>
            <a
              class="chip chip--remove"
              href={`${action}${directoryQuery({ ...filters, ...c.clear })}`}
              aria-label={`${t.directory.removeFilter}: ${c.label}`}
            >
              {c.label} <span aria-hidden="true">×</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <a
      class="button button--small toolbar__cta"
      href={pathFor(lang, '/request')}
    >
      {t.cta.requestHome}
    </a>
  </div>

  {tailors.length === 0 ? (
    <section aria-labelledby="empty">
      <h2 id="empty">{t.directory.emptyHeading}</h2>
      <p>{t.directory.emptyBody}</p>
      <p class="actions">
        {active && (
          <a class="button button--secondary" href={action}>
            {t.directory.clear}
          </a>
        )}
        <a class="button" href={pathFor(lang, '/request')}>
          {t.cta.requestHome}
        </a>
      </p>
    </section>
  ) : (
    <>
      <p class="count" data-no-match hidden>
        {t.directory.emptyBody}
      </p>
      <ul class="grid">
        {tailors.map((tailor) => (
          <li>
            <TailorCard lang={lang} tailor={tailor} />
          </li>
        ))}
      </ul>
    </>
  )}
  {truncated && <p class="notice">{t.directory.truncated}</p>}
  {!variant && areas.length > 0 && (
    <nav aria-labelledby="browse-areas">
      <h2 id="browse-areas">{t.area.browseAreas}</h2>
      <ul class="browse-links" role="list">
        {areas.map((a) => (
          <li>
            <a href={pathFor(lang, `/areas/${a.slug}`)}>{a.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {!variant && categories.length > 0 && (
    <nav aria-labelledby="browse-categories">
      <h2 id="browse-categories">{t.area.browseCategories}</h2>
      <ul class="browse-links" role="list">
        {categories.map((c) => (
          <li>
            <a href={pathFor(lang, `/categories/${c.slug}`)}>{c.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {!variant && <FaqBlock t={t} />}
  <script>
    import '../scripts/directory';
  </script>
  {tailors.some((x) => x.whatsapp) && <script>
    import '../scripts/contact-click';
  </script>}
</PublicLayout>
