---
// Small line icons (decorative: always aria-hidden; the text next to them carries the meaning).
interface Props {
  name:
    | 'arrow'
    | 'arrow-left'
    | 'search'
    | 'menu'
    | 'pin'
    | 'needle'
    | 'scissors'
    | 'home'
    | 'users'
    | 'person'
    | 'chat'
    | 'shirt'
    | 'whatsapp'
    | 'quote';
  class?: string;
}
const { name, class: className = 'icon' } = Astro.props;
// One cached sprite (public/icons.svg) instead of repeating every path in the HTML. Its symbol ids are the names above.
---

<svg class={className} width="24" height="24" aria-hidden="true" focusable="false"
  ><use href={`/icons.svg#${name}`}></use></svg
>
