---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import type { SocialName } from '../../modules/config';
import type { Dictionary } from '../../i18n/public/en';
import { pathFor, type Lang } from '../../i18n/lang';

interface Props {
  lang: Lang;
  t: Dictionary;
  social?: { name: SocialName; href: string }[];
}
const { lang, t, social = [] } = Astro.props;
const home = pathFor(lang, '/');
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <a class="brand" href={home}>
        <Logo />
        <span class="brand__text">
          <span class="site-name">{t.siteName}</span>
          <span class="brand__tagline">{t.nav.tagline}</span>
        </span>
      </a>
      {social.length > 0 && (
        <ul class="social" role="list">
          {social.map((s) => (
            <li>
              <a
                href={s.href}
                rel="noopener noreferrer"
                aria-label={t.footer.social[s.name]}
              >
                <Icon name={s.name} />
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="site-footer__note">{t.disclaimer.short}</p>
    </div>
    <nav class="footer-col" aria-label={t.footer.exploreLabel}>
      <h2 class="footer-col__title">{t.footer.explore}</h2>
      <a href={pathFor(lang, '/tailors')}>{t.nav.tailors}</a>
      <a href={`${home}#services`}>{t.nav.services}</a>
      <a href={`${home}#craft`}>{t.nav.craft}</a>
      <a href={pathFor(lang, '/business')}>{t.nav.business}</a>
    </nav>
    <nav aria-label={t.footer.label} class="footer-nav footer-col">
      <h2 class="footer-col__title">{t.footer.support}</h2>
      <a href={pathFor(lang, '/about')}>{t.footer.about}</a>
      <a href={pathFor(lang, '/how-it-works')}>{t.nav.how}</a>
      <a href={pathFor(lang, '/contact')}>{t.footer.contact}</a>
      <a href={pathFor(lang, '/privacy')}>{t.footer.privacy}</a>
      <a href={pathFor(lang, '/terms')}>{t.footer.terms}</a>
    </nav>
    <slot />
  </div>
  <div class="site-footer__bottom container">
    <p>{t.footer.closing}</p>
    <p>
      © {year} {t.siteName}. {t.footer.rights}
    </p>
  </div>
</footer>
