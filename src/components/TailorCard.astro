---
import Source from './Source.astro';
import { dictionary, fill } from '../i18n/public';
import { pathFor, type Lang } from '../i18n/lang';
import { priceText } from '../modules/directory/format';
import type { CardView } from '../modules/directory/view';
import { swatchVariant, initials } from './story/variant';
import Icon from './ui/Icon.astro';
import {
  whatsappLink,
  whatsappMessage,
} from '../modules/contact-links/whatsapp';

interface Props {
  lang: Lang;
  tailor: CardView;
}
const { lang, tailor } = Astro.props;
const t = dictionary(lang);
const price = priceText(
  t,
  tailor.priceHint?.from ?? null,
  tailor.priceHint?.to ?? null,
);
const profile = pathFor(lang, `/tailors/${tailor.slug}`);
const photo = tailor.photo;
// A stored number that is not valid must never take the page down: the button is then simply left out.
const whatsapp = (() => {
  try {
    return tailor.whatsapp
      ? whatsappLink(tailor.whatsapp, whatsappMessage(t, tailor.name))
      : null;
  } catch {
    return null;
  }
})();
---

<article class="card">
  {photo && (
    <img
      class="card__photo"
      src={`/media/${photo.base}/medium.jpg`}
      srcset={`/media/${photo.base}/thumb.jpg 320w, /media/${photo.base}/medium.jpg 800w`}
      sizes="(min-width: 48rem) 20rem, 100vw"
      alt={photo.alt}
      loading="lazy"
    />
  )}
  {!photo && (
    <div
      class={`card__swatch card__swatch--${swatchVariant(tailor.slug)}`}
      data-initials={initials(tailor.name)}
      aria-hidden="true"
    ></div>
  )}
  <div class="card__body">
    <h3 class="card__title">
      <a href={profile}>{tailor.name}</a>
    </h3>
    {tailor.specialties.length > 0 && (
      <p class="card__line">{tailor.specialties.join(' · ')}</p>
    )}
    {tailor.areas.length > 0 && (
      <p class="card__line">{tailor.areas.join(' · ')}</p>
    )}
    {tailor.homeVisits === 'yes' && (
      <p class="card__line">
        <span class="tag">{t.directory.homeVisits}</span>
      </p>
    )}
    {price && (
      <p class="card__line">
        {tailor.priceCategory
          ? fill(t.price.cardLine, { category: tailor.priceCategory, price })
          : `${t.price.approximate}: ${price}`}{' '}
        <Source lang={lang} verified={false} />
      </p>
    )}
    <div class="card__footer">
      <span class="button button--outline card__action" aria-hidden="true">
        {t.home.featured.view}
      </span>
      {whatsapp && (
        <a
          class="card__whatsapp"
          href={whatsapp}
          data-contact-channel="whatsapp"
          data-tailor={tailor.slug}
          aria-label={fill(t.home.featured.whatsapp, { name: tailor.name })}
        >
          <Icon name="whatsapp" />
        </a>
      )}
    </div>
  </div>
</article>
