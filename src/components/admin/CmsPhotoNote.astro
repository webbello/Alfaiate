---
// Where this tailor's or product's photos from the content editor come from (FR-CMS-04, FR-CMS-08): the slug to type there, and whether any are set. Read only: /admin never writes them.
import {
  cmsProductPhotos,
  cmsTailorPhotos,
} from '../../modules/media/cms-photos';
interface Props {
  kind: 'tailors' | 'products';
  slug: string;
}
const { kind, slug } = Astro.props;
const found =
  kind === 'tailors' ? cmsTailorPhotos(slug) : cmsProductPhotos(slug);
const count = (found.main ? 1 : 0) + found.gallery.length;
const collection = kind === 'tailors' ? 'tailor_photos' : 'product_photos';
// The editor opens a new entry with the slug filled in, or the existing entry (its address is the slug).
const href =
  count > 0
    ? `/cms/#/collections/${collection}/entries/${slug}`
    : `/cms/#/collections/${collection}/new?slug=${encodeURIComponent(slug)}`;
---

<section class="card">
  <h2>Photos from the content editor</h2>
  <p>
    {count > 0
      ? `${count} photo${count === 1 ? '' : 's'} set. They show on the public page only while there is no photo uploaded here.`
      : 'No photo set yet.'}
  </p>
  <p>
    <a class="button-link" href={href}>
      {count > 0 ? 'Change photos' : 'Add photos'}
    </a>
  </p>
  <p class="hint">
    Opens the content editor with this{' '}
    {kind === 'tailors' ? 'tailor' : 'product'} filled in (<code>{slug}</code>).
    A new photo appears on the site a minute or two after you save it there.
  </p>
  <p class="hint">
    Changing the slug of this {kind === 'tailors' ? 'tailor' : 'product'} here
    unlinks its photos, and the public address changes too.
  </p>
</section>
