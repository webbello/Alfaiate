---
// A password shown once, right after it was made. The page that renders this sends no-store; nothing keeps the password.
interface Props {
  title: string;
  email: string;
  password: string;
  back: string;
  backLabel: string;
  /** What happened and what to do next, in one or two sentences. */
  note: string;
}
const { title, email, password, back, backLabel, note } = Astro.props;
---

<section class="card credentials" aria-labelledby="cred-title">
  <h1 id="cred-title">{title}</h1>
  <p>{note}</p>
  <dl>
    <dt>Sign-in email</dt>
    <dd>{email}</dd>
    <dt>Password</dt>
    <dd>
      <input
        id="cred-password"
        class="credentials__secret"
        type="text"
        readonly
        autocomplete="off"
        spellcheck="false"
        value={password}
        aria-label="Password, shown once"
      />
    </dd>
  </dl>
  <p class="credentials__warn">
    This is the only time the password is shown. Give it to them in person or by
    a private message. They can change it under My account.
  </p>
  <p>
    <a class="button-link" href={back}>
      {backLabel}
    </a>
  </p>
</section>
