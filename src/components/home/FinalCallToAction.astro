---
import Icon from '../ui/Icon.astro';
import type { Dictionary } from '../../i18n/public/en';
import { pathFor, type Lang } from '../../i18n/lang';
import { scene } from './images';

interface Props {
  lang: Lang;
  t: Dictionary;
}
const { lang, t } = Astro.props;
const f = t.home.final;
const bg = scene('final-cta');
---

<section class="final" aria-labelledby="final-heading">
  <img
    class="final__image"
    src={bg.src}
    srcset={bg.srcset}
    sizes="100vw"
    width={bg.width}
    height={bg.height}
    alt=""
    loading="lazy"
    decoding="async"
  />
  <div class="final__copy container reveal">
    <h2 id="final-heading">{f.heading}</h2>
    <p>{f.body}</p>
    <p class="actions">
      <a class="button button--light" href={pathFor(lang, '/tailors')}>
        {f.find}
        <Icon name="arrow" class="icon icon--arrow" />
      </a>
      <a class="button button--ghost-light" href={pathFor(lang, '/request')}>
        {f.request}
        <Icon name="arrow" class="icon icon--arrow" />
      </a>
    </p>
  </div>
  <p class="final__script" aria-hidden="true">
    {f.script}
  </p>
</section>
