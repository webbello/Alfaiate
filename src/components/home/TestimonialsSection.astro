---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import TestimonialCard from './TestimonialCard.astro';
import { PLACEHOLDER_TESTIMONIALS, TESTIMONIALS } from './testimonials';
import type { Dictionary } from '../../i18n/public/en';

interface Props {
  t: Dictionary;
  /** Development only: show labelled sample quotes when there are no real ones. */
  placeholders?: boolean;
}
const { t, placeholders = false } = Astro.props;
const s = t.home.stories;
const sample = TESTIMONIALS.length === 0 && placeholders;
const items =
  TESTIMONIALS.length > 0
    ? TESTIMONIALS
    : sample
      ? PLACEHOLDER_TESTIMONIALS
      : [];
---

{items.length > 0 && (
  <section class="section stories" aria-labelledby="stories-heading">
    <div class="container">
      <SectionHeading
        id="stories-heading"
        eyebrow={s.eyebrow}
        heading={s.heading}
        intro={s.intro}
      >
        {items.length > 3 && (
          <span
            class="carousel-controls"
            data-carousel-controls="stories-track"
            hidden
          >
            <button
              type="button"
              class="round-button"
              data-dir="-1"
              aria-label={s.previous}
            >
              <Icon name="arrow-left" />
            </button>
            <button
              type="button"
              class="round-button round-button--dark"
              data-dir="1"
              aria-label={s.next}
            >
              <Icon name="arrow" />
            </button>
          </span>
        )}
      </SectionHeading>
      {sample && (
        <p class="sample-note" role="note">
          {s.sample}
        </p>
      )}
      <ul class="stories__track" id="stories-track" role="list">
        {items.map((item) => (
          <li>
            <TestimonialCard item={item} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
