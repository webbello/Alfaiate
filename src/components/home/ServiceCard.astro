---
import Icon from '../ui/Icon.astro';
import { scene, type Scene } from './images';

interface Props {
  href: string;
  label: string;
  image: Scene;
}
const { href, label, image } = Astro.props;
const img = scene(image);
---

<a class="service-card reveal" href={href}>
  <span class="service-card__media">
    <img
      src={img.src}
      srcset={img.srcset}
      sizes="(min-width: 75rem) 11rem, (min-width: 48rem) 22vw, 45vw"
      width={img.width}
      height={img.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="service-card__label">{label}</span>
  <span class="round-arrow">
    <Icon name="arrow" />
  </span>
</a>
