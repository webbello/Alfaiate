---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Category from '../../views/Category.astro';
import { requireBindings } from '../../modules/config';
import { getActiveCategory } from '../../modules/directory/queries';

// The 404 decision is made here, before any HTML is sent (a component cannot rewrite once streaming has started).
const slug = Astro.params.slug;
const category = slug
  ? await getActiveCategory(requireBindings(env).DB, slug)
  : null;
if (!category) return Astro.rewrite('/404');
---

<Category lang="en" category={category} />
