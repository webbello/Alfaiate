---
export const prerender = false;
import { readForm } from '../../modules/http/body';
import { env } from 'cloudflare:workers';
import Flash from '../../components/admin/Flash.astro';
import ConfirmAction from '../../components/admin/ConfirmAction.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { messageKind } from '../../modules/admin-ui/messages';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { requirePermission } from '../../modules/auth/require';
import { verifyCsrf } from '../../modules/auth/csrf';
import { SESSION_COOKIE } from '../../modules/auth/session';
import { changeOwnPassword } from '../../modules/auth/admin-users';
import { revokeUserSessions } from '../../modules/auth/session';
import { audit } from '../../modules/auth/audit';

const auth = await requirePermission(Astro, 'dashboard.view');
if (auth instanceof Response) return auth;

let code = '';
if (Astro.request.method === 'POST') {
  const form = (await readForm(Astro.request)).form;
  const token = Astro.cookies.get(SESSION_COOKIE)?.value ?? '';
  if (!(await verifyCsrf(token, form.get('csrf')?.toString())))
    return new Response('Forbidden', { status: 403 });
  if (form.get('action')?.toString() === 'signout_all') {
    // every sign-in of this person ends, this one included (a lost or lent phone)
    const { DB } = requireBindings(env);
    await revokeUserSessions(DB, auth.userId);
    await audit(DB, {
      userId: auth.userId,
      action: 'signed_out_everywhere',
      entityType: 'admin_user',
      entityId: auth.userId,
    });
    Astro.cookies.delete(SESSION_COOKIE, { path: '/' });
    return Astro.redirect('/admin/login', 303);
  }
  const result = await changeOwnPassword(
    requireBindings(env).DB,
    auth.userId,
    token,
    {
      current: form.get('current_password')?.toString() ?? '',
      next: form.get('new_password')?.toString() ?? '',
    },
  );
  code = result.ok ? 'password_changed' : result.error;
  Astro.response.status = result.ok ? 200 : 400;
}
const message = Object.hasOwn(en.adminMessages, code)
  ? en.adminMessages[code as keyof typeof en.adminMessages]
  : '';
---

<AdminLayout
  title={en.adminAccountHeading}
  description={en.adminAccountHeading}
  auth={auth}
>
  <h1>{en.adminAccountHeading}</h1>
  <p>
    <a href="/admin">{en.adminDashboardHeading}</a>
  </p>
  <p>
    {auth.email} ({auth.role})
  </p>
  {message && <Flash message={message} kind={messageKind(code)} />}
  <form method="post">
    <input type="hidden" name="csrf" value={auth.csrfToken} />
    <p>
      <label for="current">{en.adminCurrentPassword}</label>
      <br />
      <input
        id="current"
        name="current_password"
        type="password"
        autocomplete="current-password"
        required
      />
    </p>
    <p>
      <label for="next">{en.adminNewPassword}</label>
      <br />
      <input
        id="next"
        name="new_password"
        type="password"
        autocomplete="new-password"
        required
        minlength="12"
      />
    </p>
    <button type="submit">{en.adminChangePassword}</button>
  </form>

  <h2>Signed in on other devices</h2>
  <p>
    If you ticked “Keep me signed in” on a phone, it stays signed in for 30 days
    from its last use. If a phone is lost or lent, sign out everywhere: this
    ends every sign-in of yours, including this one.
  </p>
  <form method="post">
    <input type="hidden" name="csrf" value={auth.csrfToken} />
    <input type="hidden" name="action" value="signout_all" />
    <ConfirmAction
      label="Sign out everywhere"
      question="This signs you out on every device, this one too. Continue?"
      yes="Yes, sign out everywhere"
      danger
    />
  </form>
</AdminLayout>
