---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Flash from '../../components/admin/Flash.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import StatusChip from '../../components/admin/StatusChip.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { messageKind } from '../../modules/admin-ui/messages';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { requirePermission } from '../../modules/auth/require';
import { can } from '../../modules/auth/permissions';
import { listInterest } from '../../modules/interest/queries';
import { E164, telLink } from '../../modules/contact-links/tel';
import { whatsappLink } from '../../modules/contact-links/whatsapp';

const auth = await requirePermission(Astro, 'enquiry.view');
if (auth instanceof Response) return auth;

const everyone = await listInterest(requireBindings(env).DB);
const stateOf = (r: (typeof everyone)[number]) =>
  r.decision === 'approved'
    ? 'approved'
    : r.decision === 'declined'
      ? 'declined'
      : r.anonymised_at
        ? 'removed'
        : 'waiting';
const SHOWN = ['waiting', 'approved', 'declined'] as const;
const show = SHOWN.find((s) => s === Astro.url.searchParams.get('show'));
const tally = { waiting: 0, approved: 0, declined: 0 };
for (const r of everyone) {
  const s = stateOf(r);
  if (s in tally) tally[s as keyof typeof tally]++;
}
// Waiting ones first so nobody is missed; the list is already newest first.
const rows = everyone
  .filter((r) => !show || stateOf(r) === show)
  .sort(
    (a, b) =>
      Number(stateOf(b) === 'waiting') - Number(stateOf(a) === 'waiting'),
  );
const mayRemove = can(auth.role, 'enquiry.delete');
const mayDecide = can(auth.role, 'tailor.publish');
const code = Astro.url.searchParams.get('msg') ?? '';
const message = Object.hasOwn(en.adminMessages, code)
  ? en.adminMessages[code as keyof typeof en.adminMessages]
  : '';
---

<AdminLayout
  title={en.adminNavInterest}
  description={en.adminNavInterest}
  auth={auth}
>
  <PageHeader
    title={en.adminNavInterest}
    sub="Tailors who want to be listed. How it works:"
  />
  <ol class="steps-inline">
    <li>Call the tailor.</li>
    <li>
      Press <strong>Approve</strong>. This creates their draft page and a
      one-time sign-in link. Send the link to them on WhatsApp.
    </li>
    <li>
      They fill in their page. You check it under{' '}
      <a href="/admin/tailors">Tailors</a> and publish it.
    </li>
  </ol>
  <p>
    Press <strong>Decline</strong> if you do not want to list them. Nothing is
    public until you publish.
  </p>
  {message && <Flash message={message} kind={messageKind(code)} />}
  {everyone.length > 0 && (
    <nav class="chips" aria-label="Show">
      <a
        class="chip chip--neutral"
        href="/admin/interest"
        aria-current={show ? undefined : 'page'}
      >
        All {everyone.length}
      </a>
      <a
        class="chip chip--draft"
        href="/admin/interest?show=waiting"
        aria-current={show === 'waiting' ? 'page' : undefined}
      >
        Waiting for you {tally.waiting}
      </a>
      <a
        class="chip chip--published"
        href="/admin/interest?show=approved"
        aria-current={show === 'approved' ? 'page' : undefined}
      >
        Approved {tally.approved}
      </a>
      <a
        class="chip chip--declined"
        href="/admin/interest?show=declined"
        aria-current={show === 'declined' ? 'page' : undefined}
      >
        Declined {tally.declined}
      </a>
    </nav>
  )}
  {everyone.length > 0 && rows.length === 0 && (
    <EmptyState title="No one in this list" icon="interest">
      <p>
        <a class="button-link" href="/admin/interest">
          Show everyone
        </a>
      </p>
    </EmptyState>
  )}
  {everyone.length === 0 ? (
    <EmptyState title="No one yet" icon="interest">
      <p>
        When a tailor sends their details on the public Join page, they appear
        here with the newest first.
      </p>
    </EmptyState>
  ) : rows.length === 0 ? null : (
    <div class="request-list">
      {rows.map((r) => (
        <article class="card request">
          <header class="request__head">
            <div>
              <h2>{r.contact_name ?? 'Details removed'}</h2>
              <p class="request__meta">
                {[r.business_name, r.area_text].filter(Boolean).join(' · ')}
                {' · '}
                {r.phone_e164 ?? 'Details removed'}
              </p>
            </div>
            <div class="request__status">
              {r.decision === 'approved' ? (
                <StatusChip state="published" label="Approved" />
              ) : r.decision === 'declined' ? (
                <StatusChip state="declined" label="Declined" />
              ) : r.anonymised_at ? (
                <StatusChip state="archived" label="Details removed" />
              ) : (
                <StatusChip state="draft" label="Waiting for you" />
              )}
              <small>
                {r.reference_code} · received {r.created_at.slice(0, 10)}
              </small>
            </div>
          </header>
          {r.craft_text && (
            <p>
              <strong>Makes:</strong> {r.craft_text}
            </p>
          )}
          {r.message && (
            <blockquote class="request__message">{r.message}</blockquote>
          )}
          <div class="request__actions">
            {stateOf(r) === 'waiting' &&
              r.phone_e164 &&
              E164.test(r.phone_e164) && (
                <>
                  <a class="button-link" href={telLink(r.phone_e164)}>
                    Call
                  </a>
                  <a
                    class="button-link"
                    href={whatsappLink(
                      r.phone_e164,
                      `Hello, this is Alfaiate TL about your request to be listed (${r.reference_code}).`,
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    WhatsApp
                  </a>
                </>
              )}
            {r.decision === 'approved' ? (
              r.tailor_id && (
                <a class="button-link" href={`/admin/tailors/${r.tailor_id}`}>
                  Open tailor
                </a>
              )
            ) : r.decision === 'declined' ||
              r.anonymised_at ? null : mayDecide ? (
              <>
                <form method="post" action={`/admin/interest/${r.id}/approve`}>
                  <input type="hidden" name="csrf" value={auth.csrfToken} />
                  <button type="submit">Approve and make sign-in link</button>
                </form>
                <form method="post" action={`/admin/interest/${r.id}/decline`}>
                  <input type="hidden" name="csrf" value={auth.csrfToken} />
                  <button type="submit" class="secondary">
                    Decline
                  </button>
                </form>
              </>
            ) : (
              <small>Waiting for a manager to decide.</small>
            )}
          </div>
          {mayRemove && !r.anonymised_at && (
            <details class="request__remove">
              <summary>Remove this person's details</summary>
              <form method="post" action={`/admin/interest/${r.id}/anonymise`}>
                <input type="hidden" name="csrf" value={auth.csrfToken} />
                <label for={`confirm-${r.id}`}>
                  Type {r.reference_code} to confirm
                </label>
                <input
                  id={`confirm-${r.id}`}
                  name="confirm_reference"
                  autocomplete="off"
                  required
                />
                <button type="submit" class="danger">
                  Remove details
                </button>
              </form>
            </details>
          )}
        </article>
      ))}
    </div>
  )}
</AdminLayout>
