---
export const prerender = false;
import { readForm } from '../../modules/http/body';
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import CatalogAdmin from '../../components/CatalogAdmin.astro';
import { messageKind } from '../../modules/admin-ui/messages';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { requirePermission } from '../../modules/auth/require';
import { verifyCsrf } from '../../modules/auth/csrf';
import { SESSION_COOKIE } from '../../modules/auth/session';
import { listEntries, usageCounts } from '../../modules/catalog';
import { applyCatalogForm } from '../../modules/catalog/admin-actions';

const auth = await requirePermission(Astro, 'tailor.edit');
if (auth instanceof Response) return auth;
const { DB } = requireBindings(env);

if (Astro.request.method === 'POST') {
  const form = (await readForm(Astro.request)).form;
  const token = Astro.cookies.get(SESSION_COOKIE)?.value ?? '';
  if (!(await verifyCsrf(token, form.get('csrf')?.toString())))
    return new Response('Forbidden', { status: 403 });
  return Astro.redirect(
    `/admin/categories?msg=${await applyCatalogForm(DB, auth.userId, 'category', form)}`,
    303,
  );
}

const code = Astro.url.searchParams.get('msg') ?? '';
const message = Object.hasOwn(en.adminMessages, code)
  ? en.adminMessages[code as keyof typeof en.adminMessages]
  : '';
---

<AdminLayout
  title={en.adminNavCategories}
  description={en.adminNavCategories}
  auth={auth}
>
  <CatalogAdmin
    action="/admin/categories"
    heading={en.adminNavCategories}
    entries={await listEntries(DB, 'category')}
    usage={await usageCounts(DB, 'category')}
    sub="Types of clothing customers and tailors pick from. The order here is the order on the request form."
    csrf={auth.csrfToken}
    message={message}
    kind={messageKind(code)}
    withDescription={true}
  />
</AdminLayout>
