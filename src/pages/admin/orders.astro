---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { requirePermission } from '../../modules/auth/require';
import { formatMoney } from '../../modules/directory/format';
import { fitLike, likeAnywhere } from '../../modules/db/like';

const auth = await requirePermission(Astro, 'enquiry.view');
if (auth instanceof Response) return auth;
type Item = { name: string; quantity: number };
type Route = {
  kind: 'admin' | 'tailor' | 'number';
  label: string;
  items: number;
};
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 40);
const term = fitLike(q);
const { results } = await requireBindings(env)
  .DB.prepare(
    `SELECT reference_code, total_cents, items_json, routes_json, created_at FROM shop_order ${term ? "WHERE reference_code LIKE ? ESCAPE '\\'" : ''} ORDER BY id DESC LIMIT 200`,
  )
  .bind(...(term ? [likeAnywhere(term)] : []))
  .all<{
    reference_code: string;
    total_cents: number;
    items_json: string;
    routes_json: string;
    created_at: string;
  }>();
const counts = (await requireBindings(env)
  .DB.prepare(
    `SELECT count(*) AS total,
            coalesce(sum(created_at >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', 'start of day')), 0) AS today,
            coalesce(sum(created_at >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-7 days')), 0) AS week,
            coalesce(sum(created_at >= strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-30 days')), 0) AS month
     FROM shop_order`,
  )
  .first<{ total: number; today: number; week: number; month: number }>())!;
const safe = <T,>(json: string): T[] => {
  try {
    const parsed = JSON.parse(json);
    return Array.isArray(parsed) ? (parsed as T[]) : [];
  } catch {
    return [];
  }
};
const where = {
  admin: 'the admin',
  tailor: 'the tailor',
  number: 'another number',
} as const;
---

<AdminLayout
  title={en.adminNavOrders}
  description={en.adminNavOrders}
  auth={auth}
>
  <PageHeader
    title={en.adminNavOrders}
    sub="Orders that customers prepared from the shop cart. Each one was opened in the customer's own WhatsApp: you will receive the message there, with the same reference. No customer details are stored here."
  />
  <p>
    <strong>{counts.total}</strong> orders so far: {counts.today} today,{' '}
    {counts.week} in the last 7 days, {counts.month} in the last 30 days.
  </p>
  {counts.total > 0 && (
    <form method="get" action="/admin/orders" class="searchbar" role="search">
      <p>
        <label for="order-q">Find an order by reference</label>
        <input type="search" id="order-q" name="q" value={q} maxlength="40" />
      </p>
      <p>
        <button type="submit">Search</button>
        {q && <a href="/admin/orders">Clear</a>}
      </p>
    </form>
  )}
  {results.length === 0 && counts.total > 0 && (
    <EmptyState title="No order matches">
      <p>Check the reference, or clear the search.</p>
    </EmptyState>
  )}
  {results.length === 0 && counts.total === 0 && (
    <EmptyState title="No orders yet">
      <p>
        When a customer presses "Order on WhatsApp" in the cart, the order
        appears here.
      </p>
    </EmptyState>
  )}
  {results.length > 0 && (
    <ul class="req-cards" aria-label={en.adminNavOrders}>
      {results.map((o) => (
        <li class="req-card">
          <p class="req-card__top">
            <strong class="req-card__ref">{o.reference_code}</strong>
            <span>{formatMoney(o.total_cents)}</span>
          </p>
          <p class="req-card__wants">
            {safe<Item>(o.items_json)
              .map((i) => `${i.name} × ${i.quantity}`)
              .join(', ')}
          </p>
          <p class="req-card__time">
            {o.created_at.slice(0, 16).replace('T', ' ')}
          </p>
        </li>
      ))}
    </ul>
  )}
  {results.length > 0 && (
    <table class="req-table">
      <thead>
        <tr>
          <th scope="col">Reference</th>
          <th scope="col">Date</th>
          <th scope="col">Items</th>
          <th scope="col">Sent to</th>
          <th scope="col">Total (USD)</th>
        </tr>
      </thead>
      <tbody>
        {results.map((o) => (
          <tr>
            <td>{o.reference_code}</td>
            <td>{o.created_at.slice(0, 16).replace('T', ' ')}</td>
            <td>
              {safe<Item>(o.items_json)
                .map((i) => `${i.name} × ${i.quantity}`)
                .join(', ')}
            </td>
            <td>
              {safe<Route>(o.routes_json)
                .map(
                  (r) =>
                    `${where[r.kind] ?? r.kind}${r.kind === 'admin' ? '' : ` (${r.label})`}`,
                )
                .join('; ')}
            </td>
            <td>{formatMoney(o.total_cents)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
