---
export const prerender = false;
import { readForm } from '../../../modules/http/body';
import { env } from 'cloudflare:workers';
import Card from '../../../components/admin/Card.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import Flash from '../../../components/admin/Flash.astro';
import FormGrid from '../../../components/admin/FormGrid.astro';
import StickyBar from '../../../components/admin/StickyBar.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProfileFields from '../../../components/ProfileFields.astro';
import { en } from '../../../i18n/en';
import { requireBindings } from '../../../modules/config';
import { requirePermission } from '../../../modules/auth/require';
import { verifyCsrf } from '../../../modules/auth/csrf';
import { SESSION_COOKIE } from '../../../modules/auth/session';
import { listEntries } from '../../../modules/catalog';
import { createDraft } from '../../../modules/tailors/repo';
import { setAreas, setCategories } from '../../../modules/tailors/links';
import {
  areasFromForm,
  categoriesFromForm,
  profileFromForm,
} from '../../../modules/tailors/form';
import { messageFrom } from '../../../modules/tailors/messages';

const auth = await requirePermission(Astro, 'tailor.edit');
if (auth instanceof Response) return auth;

if (Astro.request.method === 'POST') {
  const form = (await readForm(Astro.request)).form;
  if (
    !(await verifyCsrf(
      Astro.cookies.get(SESSION_COOKIE)?.value ?? '',
      form.get('csrf')?.toString(),
    ))
  ) {
    return new Response('Forbidden', { status: 403 });
  }
  const { DB } = requireBindings(env);
  const created = await createDraft(DB, auth.userId, profileFromForm(form));
  if (!created.ok)
    return Astro.redirect(
      `/admin/tailors/new?msg=invalid&fields=${created.fields.join(',')}`,
      303,
    );
  // Work types and areas ticked on the first form are saved with the draft, through the same checks as the draft page.
  const [cats, areas] = await Promise.all([
    listEntries(DB, 'category'),
    listEntries(DB, 'area'),
  ]);
  const linked = [
    await setCategories(
      DB,
      auth.userId,
      auth.role,
      created.id,
      categoriesFromForm(
        form,
        cats.map((c) => c.id),
      ),
    ),
    await setAreas(
      DB,
      auth.userId,
      auth.role,
      created.id,
      areasFromForm(
        form,
        areas.map((a) => a.id),
      ),
    ),
  ].find((r) => !r.ok);
  return Astro.redirect(
    `/admin/tailors/${created.id}${linked && !linked.ok ? `?msg=${linked.error}` : ''}`,
    303,
  );
}
const { message, kind, fields } = messageFrom(Astro.url);
const [categories, areas] = await Promise.all([
  listEntries(requireBindings(env).DB, 'category'),
  listEntries(requireBindings(env).DB, 'area'),
]);
---

<AdminLayout
  title={en.tailorNewHeading}
  description={en.tailorNewHeading}
  auth={auth}
>
  <PageHeader
    title={en.tailorNewHeading}
    sub="Start with the essentials. Everything else can be added on the draft page."
    back={{ href: '/admin/tailors', label: en.tailorListHeading }}
  />
  {message && (
    <Flash message={message} kind={kind}>
      {fields.length > 0 && (
        <>
          {en.tailorCheck}: {fields.join(', ')}
        </>
      )}
    </Flash>
  )}
  <form method="post">
    <input type="hidden" name="csrf" value={auth.csrfToken} />
    <Card title="Essentials" id="essentials">
      <FormGrid>
        <ProfileFields part="essentials" />
        <fieldset class="wide">
          <legend>Work types</legend>
          {categories.length === 0 && <p>{en.tailorNoCategories}</p>}
          <div class="checkgrid">
            {categories
              .filter((c) => c.is_active)
              .map((c) => (
                <label>
                  <input type="checkbox" name={`cat_${c.id}`} /> {c.name}
                </label>
              ))}
          </div>
        </fieldset>
        <fieldset class="wide">
          <legend>Shop area</legend>
          {areas.length === 0 && <p>{en.tailorNoAreas}</p>}
          <div class="checkgrid">
            {areas
              .filter((a) => a.is_active)
              .map((a) => (
                <label>
                  <input type="checkbox" name={`shop_${a.id}`} /> {a.name}
                </label>
              ))}
          </div>
        </fieldset>
      </FormGrid>
    </Card>
    <details>
      <summary>More detail (optional, can be added later)</summary>
      <FormGrid>
        <ProfileFields part="more" />
      </FormGrid>
    </details>
    <StickyBar>
      <button type="submit">{en.tailorCreate}</button>
    </StickyBar>
  </form>
</AdminLayout>
