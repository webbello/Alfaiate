---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { requirePermission } from '../../modules/auth/require';
import {
  STATUSES,
  countByStatus,
  listEnquiries,
} from '../../modules/enquiry/queries';
import PageHeader from '../../components/admin/PageHeader.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import StatusChip from '../../components/admin/StatusChip.astro';
import { toneFor } from '../../modules/admin-ui/tone';
import { waitedText, waitingTooLong } from '../../modules/enquiry/waiting';
import { customerReach } from '../../modules/contact-links/admin-links';

const auth = await requirePermission(Astro, 'enquiry.view');
if (auth instanceof Response) return auth;

const params = Astro.url.searchParams;
const status = STATUSES.find((s) => s === params.get('status'));
const q = (params.get('q') ?? '').slice(0, 100);
const spam = params.get('spam') === '1';
const DB = requireBindings(env).DB;
const [{ rows, truncated }, counts] = await Promise.all([
  listEnquiries(DB, { status, q, spam }),
  countByStatus(DB),
]);
// A chip keeps the current search and the spam switch, and changes only the status.
const chipHref = (value?: string) => {
  const query = new URLSearchParams();
  if (value) query.set('status', value);
  if (q) query.set('q', q);
  if (spam) query.set('spam', '1');
  const text = query.toString();
  return `/admin/enquiries${text ? `?${text}` : ''}`;
};
const filtered = Boolean(status || q || spam);
const text = en.enquiry;
const now = new Date();
---

<AdminLayout title={text.heading} description={text.heading} auth={auth}>
  <PageHeader
    title={text.heading}
    sub="Requests from customers. Open one to contact them, pass it to a tailor and record what happened."
  />

  <nav class="chips" aria-label={text.statusFilter}>
    <a
      class="chip chip--neutral"
      href={chipHref()}
      aria-current={status ? undefined : 'page'}
    >
      {text.chipAll} {counts.total}
    </a>
    {STATUSES.map((s) => (
      <a
        class={`chip chip--${toneFor(s)}`}
        href={chipHref(s)}
        aria-current={status === s ? 'page' : undefined}
      >
        {text.statuses[s]} {counts.byStatus[s]}
      </a>
    ))}
  </nav>
  <p>
    <small>{text.countsNote}</small>
  </p>

  <form method="get" action="/admin/enquiries" class="searchbar">
    <input type="hidden" name="status" value={status ?? ''} />
    <p>
      <label for="q">{text.search}</label>
      <input type="search" id="q" name="q" value={q} maxlength="100" />
    </p>
    <p>
      <label>
        <input type="checkbox" name="spam" value="1" checked={spam} />
        {text.showSpam}
      </label>
    </p>
    <p>
      <button type="submit">{text.searchButton}</button>
    </p>
  </form>

  {rows.length === 0 && !filtered && counts.total === 0 && (
    <EmptyState title={text.emptyTitle}>
      <p>{text.emptyBody}</p>
      <p>
        <a class="button-link" href="/request">
          {text.emptyLink}
        </a>
      </p>
    </EmptyState>
  )}
  {rows.length === 0 && (filtered || counts.total > 0) && (
    <EmptyState title={text.noMatchTitle}>
      <p>{text.noMatchBody}</p>
      <p>
        <a class="button-link" href="/admin/enquiries">
          {text.clearFilters}
        </a>
      </p>
    </EmptyState>
  )}
  {rows.length > 0 && (
    <ul class="req-cards" aria-label={text.heading}>
      {rows.map((r) => {
        const reach = customerReach(r);
        const wants = [r.category_name, r.area_name]
          .filter(Boolean)
          .join(' · ');
        return (
          <li class="req-card">
            <p class="req-card__top">
              <a class="req-card__ref" href={`/admin/enquiries/${r.id}`}>
                {r.reference_code}
              </a>
              <StatusChip state={r.status} label={text.statuses[r.status]} />
              {waitingTooLong(r, now) && (
                <StatusChip state="overdue" label={text.waiting} />
              )}
              {r.is_spam ? (
                <StatusChip state="cancelled" label={text.spamMark} />
              ) : null}
            </p>
            <p class="req-card__who">{r.customer_name ?? text.anonymised}</p>
            <p class="req-card__wants">{wants || text.nothingChosen}</p>
            <p class="req-card__time">
              {text.received} {waitedText(r.created_at, now)}
              {waitedText(r.created_at, now) === 'just now' ? '' : ' ago'}
            </p>
            {reach && (
              <a
                class="req-big"
                href={reach.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {reach.kind === 'call'
                  ? text.callCustomer
                  : text.whatsappCustomer}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  )}
  {rows.length > 0 && (
    <table class="req-table">
      <thead>
        <tr>
          <th>{text.reference}</th>
          <th>{text.received}</th>
          <th>{text.name}</th>
          <th>{text.number}</th>
          <th>{text.status}</th>
          <th>{text.referralHeading}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>
              <a href={`/admin/enquiries/${r.id}`}>{r.reference_code}</a>
              {r.source === 'shop' && (
                <>
                  {' '}
                  <StatusChip state="referred" label="Shop" />
                </>
              )}
              {r.is_spam ? ` (${text.spamMark})` : ''}
            </td>
            <td>{r.created_at.slice(0, 10)}</td>
            <td>{r.customer_name ?? text.anonymised}</td>
            <td>{r.contact_number_e164 ?? text.anonymised}</td>
            <td>
              <StatusChip state={r.status} label={text.statuses[r.status]} />
              {waitingTooLong(r, now) && (
                <>
                  {' '}
                  <StatusChip state="overdue" label={text.waiting} />
                </>
              )}
            </td>
            <td>
              {r.referral_state ? (
                <StatusChip
                  state={r.referral_state}
                  label={en.referral.responses[r.referral_state]}
                />
              ) : (
                <small>{text.referralNone}</small>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
  {truncated && <p>{text.truncated}</p>}
</AdminLayout>
