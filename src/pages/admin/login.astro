---
export const prerender = false;
import { readForm } from '../../modules/http/body';
import { env } from 'cloudflare:workers';
import { z } from 'zod';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import Flash from '../../components/admin/Flash.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { login } from '../../modules/auth/login';
import { SESSION_COOKIE } from '../../modules/auth/session';

const schema = z.object({
  email: z.string().trim().max(254),
  password: z.string().max(1024),
  keep: z.string().optional(),
});

let email = '';
let message = '';
if (Astro.request.method === 'POST') {
  const parsed = schema.safeParse(
    Object.fromEntries((await readForm(Astro.request)).form),
  );
  email = parsed.success ? parsed.data.email : '';
  const result = parsed.success
    ? await login(requireBindings(env).DB, {
        email: parsed.data.email,
        password: parsed.data.password,
        keep: parsed.data.keep === 'yes',
        ip: Astro.request.headers.get('cf-connecting-ip') ?? undefined,
        previousToken: Astro.cookies.get(SESSION_COOKIE)?.value,
      })
    : { ok: false as const, limited: false };
  if (result.ok) {
    Astro.cookies.set(SESSION_COOKIE, result.token, {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
      expires: result.expiresAt,
    });
    return Astro.redirect('/admin', 303);
  }
  message = result.limited ? en.adminLoginLimited : en.adminLoginFailed;
  Astro.response.status = result.limited ? 429 : 401;
}
---

<AdminLayout title={en.adminLoginTitle} description={en.adminLoginTitle}>
  <div class="login__brand">
    <span class="admin-brand__mark">
      <AdminIcon name="logo" />
    </span>
    <h2>Alfaiate TL admin</h2>
    <p>Tailors, enquiries and referrals in one place.</p>
  </div>
  <div class="login__form">
    <h1>{en.adminLoginHeading}</h1>
    {message && <Flash message={message} kind="problem" />}
    <form method="post">
      <p>
        <label for="email">{en.adminEmail}</label>
        <br />
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
          value={email}
        />
      </p>
      <p>
        <label for="password">{en.adminPassword}</label>
        <br />
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </p>
      <p>
        <label class="choice" for="keep">
          <input id="keep" name="keep" type="checkbox" value="yes" />
          Keep me signed in on this device (30 days)
        </label>
      </p>
      <button type="submit">{en.adminSignIn}</button>
    </form>
  </div>
</AdminLayout>
