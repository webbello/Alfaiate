---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { en } from '../../i18n/en';
import { requirePermission } from '../../modules/auth/require';
import { can } from '../../modules/auth/permissions';
import { env } from 'cloudflare:workers';
import { requireBindings } from '../../modules/config';
import { fill } from '../../i18n/public';
import { formatMoney } from '../../modules/directory/format';
import { metrics, type Ratio } from '../../modules/reporting/metrics';
import { PERIODS, parsePeriod } from '../../modules/reporting/period';
import { isSystemEmpty } from '../../modules/admin-ui/system';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { todoItems } from '../../modules/admin-ui/todo';
import { dashboardCounters } from '../../modules/admin-ui/counters';
import PageHeader from '../../components/admin/PageHeader.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import Card from '../../components/admin/Card.astro';
import StatCard from '../../components/admin/StatCard.astro';
import { toneFor } from '../../modules/admin-ui/tone';
import { STATUSES } from '../../modules/enquiry/queries';

const auth = await requirePermission(Astro, 'dashboard.view');
if (auth instanceof Response) return auth;

const d = en.dashboard;
const period = parsePeriod(Astro.url.searchParams.get('period'));
// Figures are for roles that may read enquiries; fee figures are queried only for the owner (fee.view).
const figures = can(auth.role, 'enquiry.view')
  ? await metrics(requireBindings(env).DB, period, {
      withFees: can(auth.role, 'fee.view'),
    })
  : null;
const ratio = (r: Ratio) =>
  r.value === null
    ? d.noData
    : fill(d.ratio, {
        n: r.numerator,
        d: r.denominator,
        pct: Math.round(r.value * 100),
      });
const todo = await todoItems(requireBindings(env).DB, auth.role);
const counters = await dashboardCounters(requireBindings(env).DB, auth.role);
const gettingStarted =
  can(auth.role, 'tailor.edit') &&
  (await isSystemEmpty(requireBindings(env).DB));
const hours = (h: number, count: number) => fill(d.hours, { hours: h, count });
// The status bar: one rectangle per status, widths in percent of all enquiries in the period.
const total = figures
  ? STATUSES.reduce((sum, st) => sum + figures.byStatus[st], 0)
  : 0;
const segments = (() => {
  let x = 0;
  return STATUSES.filter((st) => figures && figures.byStatus[st] > 0).map(
    (st) => {
      const width = (figures!.byStatus[st] / total) * 100;
      const seg = { x, width, tone: toneFor(st) };
      x += width;
      return seg;
    },
  );
})();
---

<AdminLayout
  title={en.adminDashboardHeading}
  description={en.adminDashboardHeading}
  auth={auth}
>
  <PageHeader
    title={en.adminDashboardHeading}
    sub="What needs attention and how enquiries are going."
  />
  {counters.length > 0 && (
    <section class="counters" aria-label="At a glance">
      {counters.map((c) => (
        <a class="counter" href={c.href} data-counter={c.key}>
          <span class="counter__value">{c.count}</span>
          <span class="counter__label">{c.label}</span>
        </a>
      ))}
    </section>
  )}
  <section class="card todo" aria-labelledby="todo-heading">
    <h2 id="todo-heading">What needs you now</h2>
    {todo.length === 0 ? (
      <p class="todo__clear">
        <AdminIcon name="check" /> You are all caught up. New enquiries and join
        requests will appear here.
      </p>
    ) : (
      <ul class="todo__list">
        {todo.map((item) => (
          <li class="todo__item">
            <span class="todo__count">{item.count}</span>
            <span class="todo__text">
              <strong>{item.label}</strong>
              <small>{item.help}</small>
            </span>
            <a class="button-link" href={item.href}>
              {item.cta}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
  {can(auth.role, 'enquiry.view') && (
    <details class="guide">
      <summary>How this works, step by step</summary>
      <div class="guide__cols">
        <div>
          <h3>A tailor joins</h3>
          <ol>
            <li>
              The tailor sends their details on the public <strong>Join</strong>{' '}
              page. It appears under <a href="/admin/interest">Join requests</a>
              .
            </li>
            <li>
              You call them, then press <strong>Approve</strong>. This creates
              their draft page and a one-time sign-in link.
            </li>
            <li>
              Send the link to the tailor by WhatsApp. They choose a password
              and fill in their page, then press{' '}
              <strong>Ready for review</strong>.
            </li>
            <li>
              Open the page under <a href="/admin/tailors">Tailors</a>, record
              their permission and press <strong>Publish</strong>.
            </li>
          </ol>
        </div>
        <div>
          <h3>A customer asks for a tailor</h3>
          <ol>
            <li>
              The customer sends the request form. It appears under{' '}
              <a href="/admin/enquiries">Enquiries</a> as <em>New</em>.
            </li>
            <li>
              Contact the customer if needed. Then open the enquiry and{' '}
              <strong>pass it to a tailor</strong> (a referral). Copy the
              details and send them yourself by WhatsApp.
            </li>
            <li>
              When the tailor answers, record their reply. The status moves on
              as you set it.
            </li>
            <li>
              When the work is reported done, record the outcome and any fee.
              The figures on this page update.
            </li>
          </ol>
        </div>
      </div>
    </details>
  )}
  {gettingStarted && (
    <Card title={d.gettingStartedHeading} id="getting-started">
      <p>{d.gettingStartedIntro}</p>
      <ol>
        <li>
          <a href="/admin/categories">{en.adminNavCategories}</a>:{' '}
          {d.gettingStarted.categories}
        </li>
        <li>
          <a href="/admin/areas">{en.adminNavAreas}</a>:{' '}
          {d.gettingStarted.areas}
        </li>
        <li>
          <a href="/admin/tailors/new">{en.tailorNew}</a>:{' '}
          {d.gettingStarted.tailor}
        </li>
        <li>{d.gettingStarted.publish}</li>
      </ol>
    </Card>
  )}
  {!figures && (
    <EmptyState title={d.noFiguresTitle}>
      <p>{d.noFiguresBody}</p>
    </EmptyState>
  )}
  {figures && (
    <section aria-labelledby="figures">
      <div class="page-head">
        <div class="page-head__text">
          <h2 id="figures">{d.heading}</h2>
        </div>
        <nav class="tabs" aria-label={d.periodLabel}>
          {PERIODS.map((p) => (
            <a
              href={`/admin?period=${p}`}
              aria-current={p === period ? 'page' : undefined}
            >
              {d.periods[p]}
            </a>
          ))}
        </nav>
      </div>
      <p class="page-head__sub">{d.note}</p>

      <div class="card pipeline">
        <h3>{d.byStatus}</h3>
        <svg
          viewBox="0 0 100 1"
          preserveAspectRatio="none"
          role="img"
          aria-label={d.byStatus}
        >
          {total === 0 ? (
            <rect x="0" y="0" width="100" height="1" class="bar-0" />
          ) : (
            segments.map((seg) => (
              <rect
                x={seg.x}
                y="0"
                width={seg.width}
                height="1"
                class={`bar-${seg.tone}`}
              />
            ))
          )}
        </svg>
        <p class="chips">
          {STATUSES.map((s) => (
            <a
              class={`chip chip--${toneFor(s)}`}
              href={`/admin/enquiries?status=${s}`}
            >
              {en.enquiry.statuses[s]}: {figures.byStatus[s]}
            </a>
          ))}
        </p>
      </div>

      <div class="stat-grid stat-grid--hero">
        <StatCard
          hero
          icon="inbox"
          label={d.received}
          value={String(figures.enquiries)}
          help={d.receivedHelp}
        />
        <StatCard
          hero
          icon="send"
          label={d.forwarded}
          value={String(figures.referralsForwarded)}
          help={d.forwardedHelp}
        />
        <StatCard
          hero
          icon="check"
          label={d.completions}
          value={String(figures.completions)}
        />
        <StatCard
          hero
          icon="percent"
          label={d.conversion}
          value={ratio(figures.m4)}
          help={d.conversionHelp}
        />
      </div>
      <div class="stat-grid">
        <StatCard
          icon="check"
          label={d.accepted}
          value={String(figures.referralsAccepted)}
        />
        <StatCard
          icon="trend"
          label={d.acceptance}
          value={ratio(figures.m3)}
          help={d.acceptanceHelp}
        />
        <StatCard
          icon="percent"
          label={d.referralRate}
          value={ratio(figures.m2)}
          help={d.referralRateHelp}
        />
        <StatCard
          icon="tailors"
          label={d.tailors}
          value={String(figures.activeTailors)}
          help={d.tailorsHelp}
        />
        <StatCard
          icon="pointer"
          label={d.clicks}
          value={String(figures.contactClicks)}
          help={d.clicksHelp}
        />
        <StatCard
          icon="clock"
          label={d.firstContact}
          value={
            figures.timeToFirstContact.averageHours === null
              ? d.noData
              : hours(
                  figures.timeToFirstContact.averageHours,
                  figures.timeToFirstContact.count,
                )
          }
          help={d.firstContactHelp}
        />
      </div>

      {figures.fees && (
        <>
          <h2>{d.feesHeading}</h2>
          <div class="stat-grid">
            <StatCard
              icon="money"
              label={d.feesDue}
              value={formatMoney(figures.fees.due)}
              help={d.feesHelp}
            />
            <StatCard
              icon="alert"
              label={d.feesDisputed}
              value={formatMoney(figures.fees.disputed)}
            />
            <StatCard
              icon="trend"
              label={d.revenue}
              value={formatMoney(figures.fees.m7)}
              help={d.revenueHelp}
            />
            <StatCard
              icon="money"
              label={d.collection}
              value={
                figures.fees.m9.value === null
                  ? d.noData
                  : fill(d.money, {
                      paid: formatMoney(figures.fees.m9.numerator),
                      total: formatMoney(figures.fees.m9.denominator),
                      pct: Math.round(figures.fees.m9.value * 100),
                    })
              }
              help={d.collectionHelp}
            />
          </div>
        </>
      )}
    </section>
  )}
</AdminLayout>
