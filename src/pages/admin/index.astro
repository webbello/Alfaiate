---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { en } from '../../i18n/en';
import { requirePermission } from '../../modules/auth/require';
import { can } from '../../modules/auth/permissions';

const auth = await requirePermission(Astro, 'dashboard.view');
if (auth instanceof Response) return auth;
---

<Base title={en.adminTitle} description={en.adminTitle} noindex>
  <h1>{en.adminDashboardHeading}</h1>
  <p>
    {en.adminSignedInAs} {auth.email} ({auth.role})
  </p>
  <nav>
    <a href="/admin/account">{en.adminNavAccount}</a>
    {can(auth.role, 'tailor.edit') && (
      <>
        <a href="/admin/tailors">{en.adminNavTailors}</a>
        <a href="/admin/categories">{en.adminNavCategories}</a>
        <a href="/admin/areas">{en.adminNavAreas}</a>
      </>
    )}
    {can(auth.role, 'enquiry.view') && (
      <a href="/admin/enquiries">{en.adminNavEnquiries}</a>
    )}
    {can(auth.role, 'user.manage') && (
      <a href="/admin/users">{en.adminNavUsers}</a>
    )}
  </nav>
  <form method="post" action="/admin/logout">
    <input type="hidden" name="csrf" value={auth.csrfToken} />
    <button type="submit">{en.adminSignOut}</button>
  </form>
</Base>
