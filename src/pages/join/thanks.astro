---
export const prerender = false;
import JoinThanks from '../../views/JoinThanks.astro';
import { joinReferenceParam } from '../../modules/interest/page';
import { pathFor } from '../../i18n/lang';

const reference = joinReferenceParam(Astro.url);
if (!reference) return Astro.redirect(pathFor('en', '/join'), 303);
Astro.response.headers.set('Cache-Control', 'no-store');
---

<JoinThanks lang="en" reference={reference} />
