---
export const prerender = false;
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import Flash from '../../components/portal/Flash.astro';
import { requireTailor } from '../../modules/portal/require';
import {
  portalChecklist,
  progressMessage,
} from '../../modules/portal/checklist';
import { getAccountState } from '../../modules/portal/account';
import { waitingCount } from '../../modules/referral/inbox';

const auth = await requireTailor(Astro);
if (auth instanceof Response) return auth;
const p = en.portal;
const g = p.guide;
// The tailor id comes from the session only.
const tailor = await requireBindings(env)
  .DB.prepare(
    'SELECT display_name, slug, status, is_published FROM tailor WHERE id = ?',
  )
  .bind(auth.tailorId)
  .first<{
    display_name: string;
    slug: string;
    status: string;
    is_published: number;
  }>();
if (!tailor) return new Response('Not found', { status: 404 });
const items = await portalChecklist(requireBindings(env).DB, auth.tailorId);
const account = await getAccountState(requireBindings(env).DB, auth.tailorId);
const waiting = await waitingCount(requireBindings(env).DB, auth.tailorId);
const doneCount = items.filter((i) => i.done).length;
const ready = items.every((i) => !i.required || i.done);
const code = Astro.url.searchParams.get('msg') ?? '';
const messages = p.overviewMessages as Record<string, string>;
const saved = Astro.url.searchParams.get('saved') === '1';
const note = saved
  ? `${g.saved} ${progressMessage(items)}`
  : Object.hasOwn(messages, code)
    ? messages[code]
    : '';
const next = items.find((i) => !i.done);
const sent = !!account?.reviewRequestedAt;
const left = items.filter((i) => i.required && !i.done).length;
const status =
  tailor.is_published === 1
    ? p.statusLive
    : tailor.status === 'draft'
      ? p.statusDraft
      : p.statusPaused;
---

<PortalLayout title={p.title} auth={auth}>
  {waiting > 0 && (
    <div class="req-alert" role="status">
      <p>
        {waiting === 1
          ? 'You have 1 request waiting for your answer.'
          : `You have ${waiting} requests waiting for your answer.`}
      </p>
      <a href="/portal/requests">See requests</a>
    </div>
  )}
  <header class="pt-head">
    <h1 id="hero-heading" tabindex="-1" data-step-heading>
      {p.welcome}, {tailor.display_name}
    </h1>
    <p class="pt-head__lead">
      <strong>
        {doneCount} of {items.length} steps done.
      </strong>
      {tailor.is_published === 1 ? '' : ` ${status}`}
    </p>
    <progress class="progress" max={items.length} value={doneCount}>
      {doneCount} of {items.length}
    </progress>
    {tailor.is_published !== 1 && !sent && next && (
      <p class="pt-head__next">
        <a class="button button--secondary" href={next.href}>
          {g.nextUp}: {next.short}
        </a>
        <span>{g.minutes.replace('{n}', String(next.minutes))}</span>
      </p>
    )}
  </header>
  {note && (
    <Flash
      message={note}
      kind={code === 'submitted' || saved ? 'success' : 'problem'}
    />
  )}
  {tailor.is_published === 1 && (
    <section class="pt-live card" aria-labelledby="live-heading">
      <h2 id="live-heading">{g.liveHeading}</h2>
      <p>{g.liveText}</p>
      <p>
        <a class="button button--secondary" href={`/tailors/${tailor.slug}`}>
          {g.viewLive}
        </a>
      </p>
    </section>
  )}
  <h2 id="steps-heading">{p.checklistHeading}</h2>
  <ol class="portal-steplist" aria-labelledby="steps-heading">
    {items.map((i, n) => {
      const isNext = !i.done && i === next;
      const act = i.done ? 'Change' : 'Fill in';
      return (
        <li
          class={`portal-step${i.done ? ' portal-step--done' : ''}${isNext ? ' portal-step--next' : ''}`}
        >
          <span class="portal-step__num" aria-hidden="true">
            {i.done ? '\u2713' : n + 1}
          </span>
          <span class="portal-step__text">
            <strong>
              {i.label}
              {isNext && <span class="portal-step__flag">Start here</span>}
            </strong>
            <small>
              {i.done
                ? p.done
                : `${i.reason} ${g.minutes.replace('{n}', String(i.minutes))}`}
            </small>
            <span class="portal-step__tags">
              <span
                class={
                  i.required ? 'portal-tag' : 'portal-tag portal-tag--soft'
                }
              >
                {i.required ? 'Needed' : 'Optional'}
              </span>
            </span>
          </span>
          <a
            class="button button--secondary"
            href={i.href}
            aria-label={`${act}: ${i.short}`}
          >
            {act}
          </a>
        </li>
      );
    })}
  </ol>
  {tailor.is_published !== 1 &&
    (sent ? (
      <section
        class="card portal-submit portal-sent"
        aria-labelledby="sent-heading"
      >
        <h2 id="sent-heading">{g.sentHeading}</h2>
        <p>{p.waiting}</p>
        <ol class="portal-timeline">
          {g.timeline.map((t, n) => (
            <li
              aria-current={n === 1 ? 'step' : undefined}
              class={n === 0 ? 'is-done' : n === 1 ? 'is-now' : undefined}
            >
              {t}
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <form
        class={`card portal-submit${ready ? ' portal-submit--ready' : ''}`}
        method="post"
        action="/portal/submit"
      >
        <input type="hidden" name="csrf" value={auth.csrfToken} />
        <h2>{ready ? g.readyHeading : 'When you are finished'}</h2>
        <p>
          {ready
            ? g.readyText
            : `${left} needed ${left === 1 ? 'step is' : 'steps are'} left. ${g.almostText}`}
        </p>
        {ready && !items.find((i) => i.key === 'photos')?.done && (
          <p>{g.photoNudge}</p>
        )}
        <button type="submit" disabled={!ready}>
          {p.submit}
        </button>
      </form>
    ))}
  <script>
    import '../../scripts/portal-form';
  </script>
</PortalLayout>
