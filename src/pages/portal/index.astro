---
export const prerender = false;
import { env } from 'cloudflare:workers';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import Flash from '../../components/admin/Flash.astro';
import { requireTailor } from '../../modules/portal/require';
import { portalChecklist } from '../../modules/portal/checklist';
import { getAccountState } from '../../modules/portal/account';

const auth = await requireTailor(Astro);
if (auth instanceof Response) return auth;
const p = en.portal;
// The tailor id comes from the session only.
const tailor = await requireBindings(env)
  .DB.prepare(
    'SELECT display_name, status, is_published FROM tailor WHERE id = ?',
  )
  .bind(auth.tailorId)
  .first<{ display_name: string; status: string; is_published: number }>();
if (!tailor) return new Response('Not found', { status: 404 });
const items = await portalChecklist(requireBindings(env).DB, auth.tailorId);
const account = await getAccountState(requireBindings(env).DB, auth.tailorId);
const doneCount = items.filter((i) => i.done).length;
const ready = items.every((i) => !i.required || i.done);
const code = Astro.url.searchParams.get('msg') ?? '';
const messages = p.overviewMessages as Record<string, string>;
const note = messages[code] ?? '';
const status =
  tailor.is_published === 1
    ? p.statusLive
    : tailor.status === 'draft'
      ? p.statusDraft
      : p.statusPaused;
---

<PortalLayout title={p.title} auth={auth}>
  <h1>
    {p.welcome}, {tailor.display_name}
  </h1>
  <p>{status}</p>
  {note && (
    <Flash message={note} kind={code === 'submitted' ? 'success' : 'problem'} />
  )}
  <section class="portal-progress" aria-labelledby="steps-heading">
    <h2 id="steps-heading">{p.checklistHeading}</h2>
    <p>
      {doneCount} of {items.length} steps done
    </p>
    <progress class="progress" max={items.length} value={doneCount}>
      {doneCount} of {items.length}
    </progress>
  </section>
  <p>{p.checklistIntro}</p>
  <ol class="portal-steplist">
    {items.map((i) => (
      <li class={i.done ? 'portal-step portal-step--done' : 'portal-step'}>
        <span class="portal-step__text">
          <strong>{i.label}</strong>
          <small>
            {i.done ? p.done : p.todo}
            {!i.required && ' (optional)'}
          </small>
        </span>
        <a class="button-link" href={i.href}>
          {i.done ? 'Change' : 'Fill in'}
        </a>
      </li>
    ))}
  </ol>
  {tailor.is_published !== 1 &&
    (account?.reviewRequestedAt ? (
      <p class="card portal-submit">{p.waiting}</p>
    ) : (
      <form class="card portal-submit" method="post" action="/portal/submit">
        <input type="hidden" name="csrf" value={auth.csrfToken} />
        <h2>When you are finished</h2>
        <p>
          Press the button below. The Alfaiate TL team will look at your page,
          and publish it once everything is right. You do not need to do
          anything else.
        </p>
        <button type="submit" disabled={!ready}>
          {p.submit}
        </button>
        {!ready && (
          <p>
            <small>Finish the steps marked "To do" first.</small>
          </p>
        )}
      </form>
    ))}
</PortalLayout>
