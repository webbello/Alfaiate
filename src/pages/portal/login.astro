---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { z } from 'zod';
import Flash from '../../components/portal/Flash.astro';
import PortalAuthLayout from '../../layouts/PortalAuthLayout.astro';
import { en } from '../../i18n/en';
import { requireBindings } from '../../modules/config';
import { readForm } from '../../modules/http/body';
import { portalLogin } from '../../modules/portal/login';
import { TAILOR_COOKIE } from '../../modules/portal/session';

const p = en.portal;
const schema = z.object({
  email: z.string().trim().max(254),
  password: z.string().max(1024),
});
let email = '';
let message = '';
if (Astro.request.method === 'POST') {
  const parsed = schema.safeParse(
    Object.fromEntries((await readForm(Astro.request)).form),
  );
  email = parsed.success ? parsed.data.email : '';
  const result = parsed.success
    ? await portalLogin(requireBindings(env).DB, {
        ...parsed.data,
        ip: Astro.request.headers.get('cf-connecting-ip') ?? undefined,
        previousToken: Astro.cookies.get(TAILOR_COOKIE)?.value,
      })
    : { ok: false as const, limited: false };
  if (result.ok) {
    Astro.cookies.set(TAILOR_COOKIE, result.token, {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
      expires: result.expiresAt,
    });
    return Astro.redirect('/portal', 303);
  }
  message = result.limited ? p.signInLimited : p.signInFailed;
  Astro.response.status = result.limited ? 429 : 401;
}
---

<PortalAuthLayout title={p.signInHeading} rest="/portal/login">
  <h1>{p.auth.welcomeBack}</h1>
  <p class="auth__sub">{p.auth.welcomeBackText}</p>
  {message && <Flash message={message} kind="problem" />}
  <form method="post" class="auth__form">
    <div class="auth__field">
      <label for="email">{p.email}</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="username"
        required
        value={email}
      />
    </div>
    <div class="auth__field">
      <label for="password">{p.password}</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
    </div>
    <button type="submit" class="button auth__submit">
      {p.signIn}
    </button>
  </form>
  <p class="auth__alt">
    {p.auth.notYet} <a href="/join">{p.auth.joinLink}</a>
  </p>
</PortalAuthLayout>
