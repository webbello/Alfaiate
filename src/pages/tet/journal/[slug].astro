---
export const prerender = false;
import { env } from 'cloudflare:workers';
import JournalPost from '../../../theme/views/JournalPost.astro';
import { draftPosts } from '../../../modules/config';
import { visiblePosts } from '../../../modules/journal/posts';

// Drafts exist only when the preview flag is on; otherwise an unknown or draft address is a plain 404. An article with no Tetun file is a 404 here.
const post = visiblePosts(draftPosts(env as { SHOW_DRAFT_POSTS?: string }), 'tet').find((p) => p.slug === Astro.params.slug);
if (!post) return Astro.rewrite('/404');
---

<JournalPost lang="tet" {post} />
