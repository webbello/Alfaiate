{
  "name": "alfaiate-tl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "format:check": "prettier --check .",
    "test": "vitest run --project workers",
    "check": "npm run lint && npm run typecheck && npm run check:repo && npm test && npm run test:integration",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=seeds/placeholders.sql",
    "db:seed:launch": "wrangler d1 execute DB --local --file=seeds/launch.sql",
    "bench:hash": "node scripts/bench-hash.mjs",
    "test:integration": "npm run build && vitest run --project integration --project integration-en --project integration-staging",
    "owner:create": "node scripts/owner.mjs create",
    "owner:reset": "node scripts/owner.mjs reset",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "perf": "npm run build && node scripts/perf.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:demo": "node scripts/demo.mjs add",
    "db:demo:remove": "node scripts/demo.mjs remove",
    "preview": "npm run build && wrangler dev --port 4322",
    "theme:install": "npm --prefix handspark install",
    "theme:dev": "npm --prefix handspark run dev -- --port 4331",
    "theme:build": "npm --prefix handspark run build",
    "theme:preview": "npm --prefix handspark run preview -- --port 4331"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
