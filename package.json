{
  "name": "alfaiate-tl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "format:check": "prettier --check .",
    "test": "vitest run --project workers",
    "check": "npm run lint && npm run typecheck && npm run check:repo && npm test && npm run test:integration",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=seeds/placeholders.sql",
    "bench:hash": "node scripts/bench-hash.mjs",
    "test:integration": "npm run build && vitest run --project integration --project integration-en --project integration-staging",
    "owner:create": "node scripts/owner.mjs create",
    "owner:reset": "node scripts/owner.mjs reset",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "perf": "npm run build && node scripts/perf.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "astro": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
