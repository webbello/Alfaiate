{
  "name": "alfaiate-tl",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Deploying is described step by step in docs/DEPLOY.md. Resource names below are the ones that guide tells you to create.
  // Public-site settings, not secrets. Each environment sets its own (vars are not inherited). Tetum stays off
  // in production until the owner confirms a native-speaker review; SITE_URL is a placeholder until the domain is chosen (OQ-11/AD-08).
  // Optional vars that are NOT listed here (add them to the environment's "vars" when you decide): ORDER_WHATSAPP, SITE_WHATSAPP, JOIN_ENABLED,
  // NEWSLETTER_ENABLED, SOCIAL_FACEBOOK, SOCIAL_INSTAGRAM, SOCIAL_YOUTUBE, RESPONSE_WINDOW_EN, RESPONSE_WINDOW_TET, GOOGLE_SITE_VERIFICATION.
  // Secrets are never written here: FORM_TOKEN_SECRET (required) and NOTIFY_WEBHOOK_URL (optional) are set with `wrangler secret put`.
  "vars": { "SITE_URL": "https://alfaiate-tl.example", "PUBLIC_LANGUAGES": "en", "SITE_INDEXABLE": "false" },
  // Top level = local development only (simulated D1/R2 in .wrangler/state). It is never deployed: use --env staging or --env production.
  "d1_databases": [
    { "binding": "DB", "database_name": "alfaiate-tl-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_PUBLIC", "bucket_name": "alfaiate-tl-media-public" },
    { "binding": "MEDIA_PRIVATE", "bucket_name": "alfaiate-tl-media-private" }
  ],
  "env": {
    "staging": {
      "name": "alfaiate-tl-staging",
      "vars": { "SITE_URL": "https://alfaiate-tl-staging.md-irfan-tls.workers.dev", "PUBLIC_LANGUAGES": "en,tet", "SITE_INDEXABLE": "false", "PASSWORD_ITERATIONS": "100000", "ORDER_WHATSAPP": "+918864812200" },
      "d1_databases": [
        { "binding": "DB", "database_name": "alfaiate-tl-staging", "database_id": "0b1a18ba-dd44-4092-8f94-575dca4f536a", "migrations_dir": "migrations" }
      ]
      // Free plan: R2 needs a card, so photos are off. To switch them on, add a comma after the "]" above and remove the "//" at the start of the four bucket lines below (see docs/DEPLOY.md, "Switching on the paid features").
      // "r2_buckets": [
      //   { "binding": "MEDIA_PUBLIC", "bucket_name": "alfaiate-tl-staging-media-public" },
      //   { "binding": "MEDIA_PRIVATE", "bucket_name": "alfaiate-tl-staging-media-private" }
      // ]
    },
    "production": {
      "name": "alfaiate-tl-production",
      "vars": { "SITE_URL": "https://alfaiate-tl.example", "PUBLIC_LANGUAGES": "en", "SITE_INDEXABLE": "true", "PASSWORD_ITERATIONS": "100000", "ORDER_WHATSAPP": "+918864812200" },
      "d1_databases": [
        { "binding": "DB", "database_name": "alfaiate-tl-prod", "database_id": "20563516-3d15-4352-8b79-a5052d23cf4c", "migrations_dir": "migrations" }
      ]
      // Free plan: photos off (see staging above). Add a comma after the "]" above and remove the "//" markers once R2 is enabled.
      // "r2_buckets": [
      //   { "binding": "MEDIA_PUBLIC", "bucket_name": "alfaiate-tl-media-public" },
      //   { "binding": "MEDIA_PRIVATE", "bucket_name": "alfaiate-tl-media-private" }
      // ]
    }
  }
}
