# Copy to .dev.vars (git-ignored). Placeholders only; never commit real values.
# TURNSTILE_SECRET_KEY is unused: Turnstile was declined for Phase 5.
# Signs the request form's fill-time token (SEC-07). At least 16 characters; set a real value with `wrangler secret put` at deploy.
FORM_TOKEN_SECRET=replace-me-with-at-least-16-chars
# Local development: turn Tetum on and use the dev server address (the committed defaults serve English only).
PUBLIC_LANGUAGES=en,tet
SITE_URL=http://localhost:4321
# Search engines may index the site only when this is exactly "true" (production). Leave it off locally and in staging.
SITE_INDEXABLE=false
# Optional: the owner WhatsApp number for the quick-action bar on phones (OQ-06). Without it the WhatsApp button is simply not shown.
# SITE_WHATSAPP=+670XXXXXXXX
# The admin's WhatsApp number that receives shop orders (any country, +<digits>). Staff decide per tailor whether an order goes here first or to the tailor.
# Without it (and without SITE_WHATSAPP) ordering says it is not set up yet and points to the request form.
# ORDER_WHATSAPP=+XXXXXXXXXXXX
# The tailor "Join us" form is off until the owner approves its consent wording and the Privacy text (OQ-08). Set to true to try it locally.
JOIN_ENABLED=false
# The footer "Stay updated" sign-up is off until a sender exists (OQ-06) and the Privacy text covers it (OQ-08).
NEWSLETTER_ENABLED=false
# Development only: labelled sample testimonials so the section layout can be reviewed. Production never sets this (BR-11).
SHOW_TESTIMONIAL_PLACEHOLDERS=false
# Preview of journal articles that are still drafts in the content editor (/cms). Staging sets it to true; production never does (BR-11).
SHOW_DRAFT_POSTS=false
# Footer social icons: https addresses on the platform own domain only; WhatsApp uses SITE_WHATSAPP.
# SOCIAL_FACEBOOK=https://www.facebook.com/your-page
# SOCIAL_INSTAGRAM=https://www.instagram.com/your-account
# SOCIAL_YOUTUBE=https://www.youtube.com/@your-channel
# Owner notification (OQ-06): the reference code and an admin link are POSTed as plain text to this https address, for example a free ntfy.sh topic you subscribe to on your phone, or a Slack or Discord incoming webhook. Nothing personal is ever sent. Unset means no notification.
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/choose-a-long-random-topic-name
# What you can honour, shown on the thank-you pages as "We aim to contact you <this>" (OQ-05). Leave unset to promise nothing.
# RESPONSE_WINDOW_EN=within one working day
# RESPONSE_WINDOW_TET=iha loron serbisu ida laran
# Google Search Console: the content value of the HTML-tag verification (letters, digits, - and _).
# GOOGLE_SITE_VERIFICATION=
